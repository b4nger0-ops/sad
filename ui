    function ThemeManager:GetCustomTheme(file)
        if not file or file == "" then return nil end
        local path = self.Folder .. "/themes/" .. file
        if not path:match("%.json$") then
            path = path .. ".json"
        end
        if not safeIsFile(path) then
            
            path = self.Folder .. "/themes/" .. file
            if not safeIsFile(path) then return nil end
        end
        local ok, data = safeRead(path)
        if not ok then return nil end
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, data)
        if not success or type(decoded) ~= "table" then return nil end
        return decoded
    end

    function ThemeManager:ApplyScheme(scheme)
        if not scheme then return end
        for _, field in ipairs(THEME_FIELDS) do
            local hex = scheme[field]
            if hex then
                local col = parseHex(hex)
                if not col then
                    local ok, c = pcall(function()
                        if Color3.fromHex then
                            return Color3.fromHex(tostring(hex):gsub("^#", ""))
                        end
                    end)
                    if ok and typeof(c) == "Color3" then col = c end
                end
                if col and typeof(col) == "Color3" then
                    Theme[field] = col
                    if field == "AccentColor" then
                        Theme.ToggleOn = col
                        Theme.UtilityColor = col
                    end
                    if field == "OutlineColor" then
                        Theme.ToggleOff = col
                    end
                    if field == "MainColor" then
                        
                        Theme.GroupBoxColor = Color3.new(
                            math.clamp(col.R + 0.015, 0, 1),
                            math.clamp(col.G + 0.015, 0, 1),
                            math.clamp(col.B + 0.015, 0, 1)
                        )
                    end
                    local opt = Library.Options[field]
                    if opt and opt.SetValue then
                        pcall(function() opt:SetValue(col) end)
                    end
                end
            end
        end
        local utilOpt = Library.Options.UtilityColor
        if utilOpt and utilOpt.SetValue and Theme.UtilityColor then
            pcall(function() utilOpt:SetValue(Theme.UtilityColor) end)
        end
        if self.Library and self.Library.ApplyTheme then
            self.Library.ApplyTheme()
        end
    end

    function ThemeManager:ApplyTheme(themeName)
        if not themeName or themeName == "" or themeName == "--" then return end
        local custom = self:GetCustomTheme(themeName)
        if custom then
            self:ApplyScheme(custom)
            return
        end
        local built = self.BuiltInThemes[themeName]
        if built then
            self:ApplyScheme(built[2])
        end
    end

    function ThemeManager:ThemeUpdate()
        
        for _, field in ipairs(THEME_FIELDS) do
            local opt = Library.Options[field]
            if opt and opt.Value and typeof(opt.Value) == "Color3" then
                Theme[field] = opt.Value
                if field == "AccentColor" then
                    Theme.ToggleOn = opt.Value
                    Theme.UtilityColor = opt.Value
                end
                if field == "OutlineColor" then
                    Theme.ToggleOff = opt.Value
                end
                if field == "MainColor" then
                    Theme.GroupBoxColor = Color3.new(
                        math.clamp(opt.Value.R + 0.015, 0, 1),
                        math.clamp(opt.Value.G + 0.015, 0, 1),
                        math.clamp(opt.Value.B + 0.015, 0, 1)
                    )
                end
            end
        end
        if self.Library and self.Library.ApplyTheme then
            self.Library.ApplyTheme()
        end
    end

