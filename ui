        Player = Window:AddTab("Player"),
        Settings = Window:AddTab("Settings"),
    }
    self.Tabs = Tabs
    local playerTab = Tabs.Player

    local listBox = playerTab:AddLeftGroupbox("Players")
    listBox.FullWidth = true -- spans entire player tab (not half-column)
    -- Must sort by LayoutOrder so bottom filters stay under the list and
    -- selection actions stay under search (default SortOrder is Name).
    if listBox.Layout then
        listBox.Layout.SortOrder = Enum.SortOrder.LayoutOrder
    end

    -- forward decls used by toolbar chips created before the real functions
    local rebuildList
    local refreshActionButtons
    local selectPlayer

    ---------------------------------------------------------------------------
    -- Always full-width: reLayout keeps resetting to half-column, so we
    -- re-assert full width whenever Size/Position/content changes.
    ---------------------------------------------------------------------------
    do
        local enforcing = false
        local function forceFullWidth()
            if enforcing then return end
            local box = listBox and listBox.Box
            local inner = playerTab and playerTab.Inner
            if not box or not inner then return end
            local totalWidth = math.max(inner.AbsoluteSize.X, 1)
            if totalWidth < 40 then return end
            local padding = 8
            local full = math.max(120, math.floor(totalWidth - padding * 2))

            local curW = box.Size.X.Offset
            local curX = box.Position.X.Offset
            local curY = box.Position.Y.Offset
            local curH = box.Size.Y.Offset
            if math.abs(curW - full) > 1 or curX ~= padding then
                enforcing = true
                box.Position = UDim2.fromOffset(padding, curY)
                box.Size = UDim2.fromOffset(full, curH)
                playerTab.LeftY = curY + curH + 8
                if playerTab.UpdateCanvas then
                    pcall(playerTab.UpdateCanvas)
                end
                enforcing = false
            end
        end
        listBox._ForceFullWidth = forceFullWidth
        if listBox.Box then
            listBox.Box:GetPropertyChangedSignal("Size"):Connect(function()
                task.defer(forceFullWidth)
            end)
            listBox.Box:GetPropertyChangedSignal("Position"):Connect(function()
                task.defer(forceFullWidth)
            end)
        end
        if listBox.Layout then
            listBox.Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                task.defer(forceFullWidth)
            end)
        end
        if playerTab.Inner then
            playerTab.Inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(forceFullWidth)
        end
        if playerTab.Content then
            playerTab.Content:GetPropertyChangedSignal("AbsoluteSize"):Connect(forceFullWidth)
        end
        task.defer(forceFullWidth)
        task.delay(0.1, forceFullWidth)
        task.delay(0.35, forceFullWidth)
        task.delay(1.0, forceFullWidth)
        task.spawn(function()
            for _ = 1, 12 do
                task.wait(0.2)
                forceFullWidth()
            end
        end)
    end

    local searchInput = listBox:AddInput("Search", {
