    return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function parseHex(hex)
    if typeof(hex) == "Color3" then return hex end
    if type(hex) ~= "string" then return nil end
    hex = hex:gsub("^#", ""):gsub("%s+", "")
    if #hex == 3 then
        hex = hex:sub(1,1):rep(2) .. hex:sub(2,2):rep(2) .. hex:sub(3,3):rep(2)
    end
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1, 2), 16)
    local g = tonumber(hex:sub(3, 4), 16)
    local b = tonumber(hex:sub(5, 6), 16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r, g, b)
end

local function toHex(col)
    if typeof(col) ~= "Color3" then return "000000" end
    if col.ToHex then
        local ok, h = pcall(function() return col:ToHex() end)
        if ok and type(h) == "string" then
            return h:gsub("^#", "")
        end
    end
    local r = math.floor(col.R * 255 + 0.5)
    local g = math.floor(col.G * 255 + 0.5)
    local b = math.floor(col.B * 255 + 0.5)
    return string.format("%02x%02x%02x", r, g, b)
end

local function getTextWidth(text, textSize)
    return TextService:GetTextSize(text, textSize, Font, Vector2.new(1000, 50)).X
end

local function getDecimals(n)
    if typeof(n) ~= "number" then return 0 end
    local s = string.format("%.10f", math.abs(n)):gsub("0+$", ""):gsub("%.$", "")
    local dot = s:find("%.")
    if not dot then return 0 end
    return #s - dot
end

local function roundTo(n, decimals)
    local mult = 10 ^ decimals
    return math.floor(n * mult + 0.5) / mult
end

