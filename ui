                char.HumanoidRootPart.CFrame = OriginalCFrame + Vector3.new(2, 0, 0)
                task.delay(0.25, function() getgenv().SwimMethod = false end)
            end
            AtSafe = false
            OriginalCFrame = nil
        end
    end

