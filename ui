        local t = math.clamp((h - 420) / 480, 0, 1)
        local scale = 0.85 + t * 0.4
        ROW_H = math.floor(44 * scale + 0.5)
        AVATAR_SZ = math.floor(32 * scale + 0.5)
        ROW_TEXT_1 = math.floor(12 * scale + 0.5)
