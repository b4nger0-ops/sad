local function safeWrite(path, data)
    if writefile then
        local ok, err = pcall(writefile, path, data)
        return ok, err
    end
    return false, "writefile not available"
end
local function safeRead(path)
    if readfile then
        local ok, data = pcall(readfile, path)
        if ok then return true, data end
        return false, data
    end
    return false, "readfile not available"
end
local function safeIsFile(path)
    if isfile then
        local ok, r = pcall(isfile, path)
        return ok and r
    end
    return false
end
local function safeIsFolder(path)
    if isfolder then
        local ok, r = pcall(isfolder, path)
        return ok and r
    end
    return false
end
local function safeMakeFolder(path)
    if makefolder then pcall(makefolder, path) end
end
local function safeListFiles(path)
    if listfiles then
        local ok, list = pcall(listfiles, path)
        if ok and type(list) == "table" then return list end
    end
    return {}
