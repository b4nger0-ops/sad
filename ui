local function getPlayerHealthValues(plr, hum)
    -- Match game health (character attribute first, then humanoid)
    local char = plr and plr.Character
    hum = hum or (char and char:FindFirstChildOfClass("Humanoid"))

    local hp, maxHp

    if char then
        local a = char:GetAttribute("Health")
        if typeof(a) == "number" then hp = a end
        local m = char:GetAttribute("MaxHealth")
        if typeof(m) == "number" and m > 0 then maxHp = m end
    end

    if hum then
        if hp == nil then
            local a = hum:GetAttribute("Health")
            if typeof(a) == "number" then
                hp = a
            else
                hp = hum.Health
            end
        end
        if maxHp == nil then
            local m = hum:GetAttribute("MaxHealth")
            if typeof(m) == "number" and m > 0 then
                maxHp = m
            elseif hum.MaxHealth and hum.MaxHealth > 0 then
                maxHp = hum.MaxHealth
            end
        end
    end

    -- RS Status fallback (some builds store vitals there)
    if (hp == nil or maxHp == nil) and plr then
        pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            local rp = rs:FindFirstChild("Players") and rs.Players:FindFirstChild(plr.Name)
            local st = rp and rp:FindFirstChild("Status")
            if st then
                if hp == nil then
                    local a = st:GetAttribute("Health")
                    if typeof(a) == "number" then hp = a end
                end
                if maxHp == nil then
                    local m = st:GetAttribute("MaxHealth")
                    if typeof(m) == "number" and m > 0 then maxHp = m end
                end
            end
        end)
    end

    if typeof(hp) ~= "number" then hp = 0 end
    if typeof(maxHp) ~= "number" or maxHp <= 0 then maxHp = 100 end
    return hp, maxHp
end

function SettingsManager:PlayerManager()
    local Window = self.Window
    assert(Window, "PlayerManager requires SettingsManager.Window")

    local Tabs = {
        Visuals = Window:AddTab("Visuals"),
