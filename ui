    playPreviewAnim = function(name)
        currentAnimName = name or "None"
        stopPreviewAnim()
        liveSyncTarget = nil
        if currentAnimName == "None" or currentAnimName == "" then
            stabilizePreviewRig(false)
            return
        end
        if not dummy or not dummy.Parent then return end

        -- Live: mirror source character part CFrames every frame (real pose + gear)
        if currentAnimName == "Live" or string.lower(currentAnimName) == "live" then
            liveSyncTarget = sourceModel
            stabilizePreviewRig(false)
            if dummy then
                local hum = dummy:FindFirstChildOfClass("Humanoid")
                if hum then
                    local animator = hum:FindFirstChildOfClass("Animator")
                    if animator then
                        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                            pcall(function() t:Stop(0) end)
                        end
                    end
                end
            end
            if rebuildLivePairs then rebuildLivePairs() end
            if AnimBtn then AnimBtn.Text = "  Live" end
            return
        end

        -- Non-Live animation: freeze live sync and prepare motors
        stabilizePreviewRig(true)

        local ids = {}
        local fromAnimate = getIdFromAnimate(currentAnimName)
        if fromAnimate then table.insert(ids, fromAnimate) end
        local fromAnimateLower = getIdFromAnimate(string.lower(currentAnimName))
        if fromAnimateLower and fromAnimateLower ~= fromAnimate then
            table.insert(ids, fromAnimateLower)
        end
        for _, a in ipairs(getAnimList()) do
            if a.Name == currentAnimName or (a.RawName and string.lower(a.RawName) == string.lower(currentAnimName)) then
                if a.Ids then
                    for _, id in ipairs(a.Ids) do
                        local nid = normalizeAnimId(id)
                        if nid then table.insert(ids, nid) end
                    end
                end
                break
            end
        end
        if #ids == 0 then return end

        if not previewAnimFolder or previewAnimFolder.Parent ~= dummy then
            previewAnimFolder = Instance.new("Folder")
            previewAnimFolder.Name = "PreviewAnims"
            previewAnimFolder.Parent = dummy
        end

        local hum = dummy:FindFirstChildOfClass("Humanoid") or dummyHum
        if not hum then return end

        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end

        for _, animId in ipairs(ids) do
            local anim = Instance.new("Animation")
            anim.Name = currentAnimName
            anim.AnimationId = animId
            anim.Parent = previewAnimFolder
            currentAnimInstance = anim

            pcall(function() ContentProvider:PreloadAsync({ anim }) end)

            local track
            local ok2, t2 = pcall(function() return animator:LoadAnimation(anim) end)
            if ok2 and t2 then
                track = t2
            else
                local ok1, t1 = pcall(function() return hum:LoadAnimation(anim) end)
                if ok1 and t1 then track = t1 end
            end

            if track then
                track.Looped = true
                track.Priority = Enum.AnimationPriority.Action4
                pcall(function() track:Play(0) end)
                pcall(function() track:AdjustSpeed(1) end)
                pcall(function() track:AdjustWeight(1, 0) end)
                task.delay(0.08, function()
                    if track then
                        pcall(function()
                            if not track.IsPlaying then track:Play(0) end
                        end)
                    end
                end)
                currentAnimTrack = track
                if AnimBtn then AnimBtn.Text = "  " .. tostring(currentAnimName) end
                return
            end

            pcall(function() anim:Destroy() end)
            currentAnimInstance = nil
        end
    end

