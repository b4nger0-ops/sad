    function ThemeManager:LoadDefault()
        local theme = self.DefaultTheme or "Default"
        local path = self.Folder .. "/themes/default.txt"
        if safeIsFile(path) then
            local ok, content = safeRead(path)
            if ok and content and content ~= "" then
                content = content:gsub("%s+$", ""):gsub("^%s+", "")
                if self.BuiltInThemes[content] or self:GetCustomTheme(content) then
                    theme = content
                end
            end
        end
        self:ApplyTheme(theme)
        local listOpt = Library.Options.ThemeManager_ThemeList
        if listOpt and listOpt.SetValue and self.BuiltInThemes[theme] then
            listOpt:SetValue(theme)
        end
    end

    function ThemeManager:SaveCustomTheme(file)
        if not file or file:gsub(" ", "") == "" then
            return notify("Invalid file name for theme (empty)")
        end
        local theme = {}
        for _, field in ipairs(THEME_FIELDS) do
            local opt = Library.Options[field]
            local col = (opt and opt.Value) or Theme[field]
            if typeof(col) == "Color3" then
                theme[field] = toHex(col)
            end
        end
        local name = file
        if not name:match("%.json$") then name = name .. ".json" end
        local ok, err = safeWrite(self.Folder .. "/themes/" .. name, HttpService:JSONEncode(theme))
        if not ok then
            return notify("Failed to save theme: " .. tostring(err))
        end
        notify('Saved theme "' .. file .. '"')
    end

    function ThemeManager:ReloadCustomThemes()
        local list = safeListFiles(self.Folder .. "/themes")
        local out = {}
        for i = 1, #list do
            local file = list[i]
            if type(file) == "string" and file:sub(-5) == ".json" then
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(out, name) end
            end
        end
        table.sort(out)
        if #out == 0 then out = { "--" } end
        return out
    end

