    local function stabilizePreviewRig(forAnim)
        if not dummy then return end
        local root = dummy:FindFirstChild("HumanoidRootPart") or dummy.PrimaryPart
        local motorConnected = {}
        for _, d in ipairs(dummy:GetDescendants()) do
            if d:IsA("Motor6D") then
                if d.Part0 then motorConnected[d.Part0] = true end
                if d.Part1 then motorConnected[d.Part1] = true end
                -- reset transform so animation can drive cleanly
                if forAnim then
                    pcall(function() d.Transform = CFrame.new() end)
                end
            end
        end
        for _, p in ipairs(dummy:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.CanQuery = false
                p.CanTouch = false
                p.Massless = true
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                if p == root or p.Name == "HumanoidRootPart" or p.Name == "PreviewHold" then
                    p.Anchored = true
                    if root and p == root then
                        p.CFrame = CFrame.new(0, 2, 0)
                    end
                elseif motorConnected[p] then
                    -- body limbs driven by motors / animator
                    p.Anchored = false
                else
                    -- orphan meshes / floating hands / gear leftovers: pin or hide
                    if forAnim then
                        -- hide non-rig debris so they don't flap in the air
                        p.Anchored = true
                        if not (p.Parent and p.Parent:IsA("Accessory")) then
                            if not BODY_PART_NAMES[p.Name] then
                                p.Transparency = 1
                            end
                        end
                    else
                        p.Anchored = true
                    end
                end
            end
        end
        local hum = dummy:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.AutoRotate = false
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        end
