    rebuildLivePairs = function()
        liveMotorPairs = {}
        livePartPairs = {}
        if not dummy then return end
        local src = liveSyncTarget or sourceModel
        if not src or not src.Parent then return end

        local function indexMotors(root)
            local map = {}
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("Motor6D") then
                    -- key by name + part0/part1 names for uniqueness
                    local k = d.Name .. "|" .. (d.Part0 and d.Part0.Name or "") .. "|" .. (d.Part1 and d.Part1.Name or "")
                    map[k] = d
                    map[d.Name] = map[d.Name] or d
                end
            end
            return map
        end
        local sm = indexMotors(src)
        for _, d in ipairs(dummy:GetDescendants()) do
            if d:IsA("Motor6D") then
                local k = d.Name .. "|" .. (d.Part0 and d.Part0.Name or "") .. "|" .. (d.Part1 and d.Part1.Name or "")
                local srcM = sm[k] or sm[d.Name]
                if srcM then
                    table.insert(liveMotorPairs, { clone = d, source = srcM })
                end
            end
        end

        -- gear / accessory / tool parts (not body limbs) matched by full path name
        local body = {
            HumanoidRootPart=true, Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
            ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
            LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
            RightUpperArm=true, RightLowerArm=true, RightHand=true,
            LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
            RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
        }
        local function indexParts(root)
            local map = {}
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") and not body[d.Name] then
                    map[d.Name] = map[d.Name] or d
                    local p = d.Parent
                    if p then map[p.Name .. "/" .. d.Name] = d end
                end
            end
            return map
        end
        local sp = indexParts(src)
        for _, d in ipairs(dummy:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "PreviewHold" and d.Name ~= "HumanoidRootPart" and not body[d.Name] then
                local p = d.Parent
                local srcP = (p and sp[p.Name .. "/" .. d.Name]) or sp[d.Name]
                if srcP then
                    table.insert(livePartPairs, { clone = d, source = srcP })
                end
            end
        end
    end

    local lastGearRebuild = 0
    local function pruneOrphanGear()
        -- Remove clone gear/tools that no longer exist on the live source (stops floating items)
        if not dummy then return end
        local src = liveSyncTarget or sourceModel
        if not src or not src.Parent then return end
        local body = {
            HumanoidRootPart=true, Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
            ["Left Arm"]=true, ["Right Arm"]=true, ["Left Leg"]=true, ["Right Leg"]=true,
            LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
            RightUpperArm=true, RightLowerArm=true, RightHand=true,
            LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
            RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
            Humanoid=true, Animate=true, PreviewHold=true, PreviewChar=true,
        }
        local srcNames = {}
        for _, d in ipairs(src:GetDescendants()) do
            if d:IsA("BasePart") and not body[d.Name] then
                srcNames[d.Name] = true
                if d.Parent then srcNames[d.Parent.Name .. "/" .. d.Name] = true end
            end
            if d:IsA("Accessory") or d:IsA("Tool") or d:IsA("HopperBin") then
                srcNames[d.Name] = true
            end
        end
        local kill = {}
        for _, ch in ipairs(dummy:GetChildren()) do
            if (ch:IsA("Accessory") or ch:IsA("Tool") or ch:IsA("HopperBin")) and not srcNames[ch.Name] then
                table.insert(kill, ch)
            end
        end
        for _, d in ipairs(dummy:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "PreviewHold" and not body[d.Name] then
                local p = d.Parent
                local key = p and (p.Name .. "/" .. d.Name) or d.Name
                if not srcNames[key] and not srcNames[d.Name] then
                    -- only kill parts that look like gear (parent is Accessory/Tool or Handle)
                    if (p and (p:IsA("Accessory") or p:IsA("Tool") or p:IsA("HopperBin"))) or d.Name == "Handle" then
                        table.insert(kill, d)
                    end
                end
            end
        end
        for _, obj in ipairs(kill) do
            pcall(function() obj:Destroy() end)
        end
        -- Clone newly equipped tools/accessories from source
        for _, ch in ipairs(src:GetChildren()) do
            if (ch:IsA("Accessory") or ch:IsA("Tool") or ch:IsA("HopperBin")) and not dummy:FindFirstChild(ch.Name) then
                local ok, clone = pcall(function() return ch:Clone() end)
                if ok and clone then
                    for _, d in ipairs(clone:GetDescendants()) do
                        if d:IsA("BasePart") then
                            d.Anchored = true
                            d.CanCollide = false
                            d.Massless = true
                        elseif d:IsA("Script") or d:IsA("LocalScript") then
                            pcall(function() d:Destroy() end)
                        end
                    end
                    clone.Parent = dummy
                end
            end
        end
    end

    local function syncLivePose()
        if not dummy then return end
        local src = liveSyncTarget or sourceModel
        if not src or not src.Parent then return end
        local now = tick()
        if #liveMotorPairs == 0 and #livePartPairs == 0 then
            rebuildLivePairs()
        elseif (now - lastGearRebuild) > 0.35 then
            lastGearRebuild = now
            pcall(pruneOrphanGear)
            rebuildLivePairs()
        end

        local sRoot = src:FindFirstChild("HumanoidRootPart") or src.PrimaryPart
        local cRoot = dummy:FindFirstChild("HumanoidRootPart") or dummy.PrimaryPart
        if sRoot and cRoot then
            -- place root at origin, preserve live world rotation (look direction / lean)
            cRoot.CFrame = CFrame.new(0, 2, 0) * (sRoot.CFrame - sRoot.CFrame.Position)
        end

        for i = #liveMotorPairs, 1, -1 do
            local pair = liveMotorPairs[i]
            local cm, sm = pair.clone, pair.source
            if cm and cm.Parent and sm and sm.Parent then
                cm.Transform = sm.Transform
                cm.C0 = sm.C0
                cm.C1 = sm.C1
            else
                table.remove(liveMotorPairs, i)
            end
        end

        if sRoot then
            local origin = CFrame.new(0, 2, 0)
            local delta = origin * sRoot.CFrame:Inverse()
            for i = #livePartPairs, 1, -1 do
                local pair = livePartPairs[i]
                local cp, sp = pair.clone, pair.source
                if cp and cp.Parent and sp and sp.Parent then
                    cp.CFrame = delta * sp.CFrame
                else
                    if cp and cp.Parent then
                        pcall(function() cp:Destroy() end)
                    end
                    table.remove(livePartPairs, i)
                end
            end
        end
    end

