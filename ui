        local yaw = spinAngle or 0
        local pitch = manualPitch or 0
        -- scale distance inversely with frame size so bigger panel = bigger model
        local fw = (ESPFrame and ESPFrame.AbsoluteSize.X) or 180
        local sizeScale = math.clamp(fw / 180, 0.7, 2.8)
        dist = dist / sizeScale
        local offset = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * Vector3.new(0, height, -dist)
