    -- Auto-refresh when player set changes OR UI rows go missing
    task.spawn(function()
        local lastSig = ""
        while listHost and listHost.Parent do
            local players = Players:GetPlayers()
            local ids = {}
            local expected = 0
            for _, p in ipairs(players) do
                if p ~= Players.LocalPlayer then
                    expected = expected + 1
                    table.insert(ids, tostring(p.UserId))
                end
            end
            table.sort(ids)
            local sig = table.concat(ids, ",")

            -- Count live row buttons still parented under the scroll list
            local uiCount = 0
            local missingPlayer = false
            if type(rowButtons) == "table" then
                for uid, entry in pairs(rowButtons) do
                    if type(entry) == "table" and entry.btn and entry.btn.Parent then
                        uiCount = uiCount + 1
                        if typeof(uid) == "number" and uid > 0 then
                            if not Players:GetPlayerByUserId(uid) then
                                missingPlayer = true
                            end
                        end
                    end
                end
            end
            -- Also scan scroll children in case rowButtons got out of sync
            local scrollKids = 0
            if scroll and scroll.Parent then
                for _, ch in ipairs(scroll:GetChildren()) do
                    if ch:IsA("TextButton") then
                        scrollKids = scrollKids + 1
                    end
                end
            end

            local needRebuild = false
            if sig ~= lastSig then
                needRebuild = true
            elseif missingPlayer then
                needRebuild = true
            elseif expected > 0 and uiCount == 0 and scrollKids == 0 then
                -- List emptied while players still exist (common after detach/redock glitches)
                needRebuild = true
            elseif expected > 0 and uiCount ~= expected and scrollKids ~= expected then
                -- Mismatch between server player set and visible rows
                needRebuild = true
            end

            if needRebuild then
                lastSig = sig
                if rebuildList then
                    pcall(rebuildList)
                end
            end
            task.wait(1.25)
        end
    end)

