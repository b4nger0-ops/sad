            function group:AddDropdown(text, opts)
                opts = opts or {}
                local values = opts.Values or {"Option"}
                local multi = opts.Multi == true
                local cur
                if multi then
                    cur = {}
                    if type(opts.Default) == "table" then
                        for _, v in ipairs(opts.Default) do cur[tostring(v)] = true end
                    elseif opts.Default ~= nil then
                        cur[tostring(opts.Default)] = true
                    end
                else
                    cur = opts.Default or values[1]
                end

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 40)
                row.ClipsDescendants = false
                row.ZIndex = 20
                row.Parent = cont
                registerFeature(text, row)

                local lbl = Instance.new("TextLabel")
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1, 0, 0, 14)
                lbl.Font = Font
                lbl.Text = text
                lbl.TextColor3 = Theme.FontColor
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = row
                register(lbl, {TextColor3 = "FontColor"})

                -- Searchable field (Item Finder style)
                local searchBox = Instance.new("TextBox")
                searchBox.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
                searchBox.BorderSizePixel = 0
                searchBox.Position = UDim2.new(0, 0, 0, 16)
                searchBox.Size = UDim2.new(1, 0, 0, 20)
                searchBox.Font = Font
                searchBox.PlaceholderText = multi and "Search / selected..." or "Search..."
                searchBox.Text = ""
                searchBox.TextColor3 = Theme.FontColor
                searchBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
                searchBox.TextSize = 12
                searchBox.ClearTextOnFocus = false
                searchBox.ClipsDescendants = true
                searchBox.TextXAlignment = Enum.TextXAlignment.Left
                searchBox.ZIndex = 21
                searchBox.Parent = row
                Instance.new("UIStroke", searchBox).Color = Theme.OutlineColor
                do
                    local pad = Instance.new("UIPadding")
                    pad.PaddingLeft = UDim.new(0, 6)
                    pad.PaddingRight = UDim.new(0, 6)
                    pad.Parent = searchBox
                end
                if opts.Tooltip then Tooltip:Attach(row, opts.Tooltip) end

                -- Float on ScreenGui so groupbox ClipsDescendants cannot hide options
                local dropList = Instance.new("ScrollingFrame")
                dropList.Name = "LibDropList"
                dropList.BackgroundColor3 = Theme.MainColor
                dropList.BorderSizePixel = 0
                dropList.Size = UDim2.fromOffset(120, 0)
                dropList.Visible = false
                dropList.ZIndex = 500
                dropList.ClipsDescendants = true
                dropList.ScrollBarThickness = 3
                dropList.ScrollBarImageColor3 = Theme.AccentColor
                dropList.CanvasSize = UDim2.new(0, 0, 0, 0)
                dropList.Active = true
                dropList.Parent = ScreenGui
                Instance.new("UIStroke", dropList).Color = Theme.OutlineColor
                local dropLayout = Instance.new("UIListLayout")
                dropLayout.SortOrder = Enum.SortOrder.LayoutOrder
                dropLayout.Parent = dropList

                local dropOpen = false
                local filterText = ""
                local suppressText = false

                local function selectedList()
                    if not multi then return {} end
                    local out = {}
                    for k in pairs(cur) do table.insert(out, k) end
                    table.sort(out, function(a, b) return string.lower(a) < string.lower(b) end)
                    return out
                end

                local function displayText()
                    if multi then
                        local names = selectedList()
                        if #names == 0 then return "" end
                        return table.concat(names, ", ") .. ", "
                    end
                    return cur and tostring(cur) or ""
                end

                local function setSearchDisplay()
                    suppressText = true
                    searchBox.Text = displayText()
                    filterText = ""
                    suppressText = false
                end

                local function isSelected(name)
                    if multi then return cur[tostring(name)] == true end
                    return tostring(name) == tostring(cur)
                end

                local function fireCallback()
                    if not opts.Callback then return end
                    if multi then
                        pcall(opts.Callback, selectedList())
                    else
                        pcall(opts.Callback, cur)
                    end
                end

                local function placeDropList(h)
                    local abs = searchBox.AbsolutePosition
                    local asz = searchBox.AbsoluteSize
                    local parentAbs = ScreenGui.AbsolutePosition
                    local w = math.max(asz.X, 120)
                    dropList.Size = UDim2.fromOffset(w, h)
                    dropList.Position = UDim2.fromOffset(
                        abs.X - parentAbs.X,
                        abs.Y - parentAbs.Y + asz.Y + 2
                    )
                end

                local dropObj
                local function rebuildOptions()
                    for _, c in ipairs(dropList:GetChildren()) do
                        if c:IsA("TextButton") then c:Destroy() end
                    end
                    local filt = string.lower(filterText or "")
                    local order = 0
                    for _, name in ipairs(values) do
                        if filt == "" or string.lower(tostring(name)):find(filt, 1, true) then
                            order = order + 1
                            local sel = isSelected(name)
                            local optBtn = Instance.new("TextButton")
                            optBtn.BackgroundColor3 = sel and Color3.fromRGB(40, 40, 48) or Color3.fromRGB(28, 28, 28)
                            optBtn.BorderSizePixel = 0
                            optBtn.Size = UDim2.new(1, 0, 0, IsMobile and 28 or 20)
                            optBtn.Font = Font
                            optBtn.Text = (sel and "  ✓  " or "     ") .. tostring(name)
                            optBtn.TextColor3 = sel and Theme.AccentColor or Theme.FontColor
                            optBtn.TextSize = 12
                            optBtn.TextXAlignment = Enum.TextXAlignment.Left
                            optBtn.ZIndex = 501
                            optBtn.LayoutOrder = order
                            optBtn.AutoButtonColor = false
                            optBtn:SetAttribute("OptName", tostring(name))
                            optBtn.Parent = dropList
                            optBtn.MouseButton1Click:Connect(function()
                                if multi then
                                    local key = tostring(name)
                                    if cur[key] then cur[key] = nil else cur[key] = true end
                                    dropObj.Value = selectedList()
                                    setSearchDisplay()
                                    rebuildOptions()
                                    fireCallback()
                                else
                                    dropObj:SetValue(name)
                                    dropOpen = false
                                    dropList.Visible = false
                                    dropList.Size = UDim2.fromOffset(dropList.AbsoluteSize.X, 0)
                                    setSearchDisplay()
                                end
                            end)
                        end
                    end
                    dropList.CanvasSize = UDim2.new(0, 0, 0, order * 20)
                    if dropOpen then
                        local h = math.min(160, math.max(40, order * 20))
                        placeDropList(h)
                    end
                end

                local function setDropOpen(open)
                    dropOpen = open and true or false
                    if not dropOpen then
                        dropList.Visible = false
                        dropList.Size = UDim2.fromOffset(math.max(120, searchBox.AbsoluteSize.X), 0)
                        setSearchDisplay()
                        return
                    end
                    dropList.Visible = true
                    dropList.BackgroundColor3 = Theme.MainColor
                    local st = dropList:FindFirstChildOfClass("UIStroke")
                    if st then st.Color = Theme.OutlineColor end
                    rebuildOptions()
                end

                local function applyMultiFromText(text)
                    if not multi then return false end
                    text = tostring(text or "")
                    local parts = {}
                    for token in string.gmatch(text, "([^,]+)") do
                        local t = token:match("^%s*(.-)%s*$") or ""
                        if t ~= "" then table.insert(parts, t) end
                    end
                    local endsWithComma = text:match(",%s*$") ~= nil
                    local filt = ""
                    local selParts = parts
                    if not endsWithComma and #parts > 0 then
                        filt = parts[#parts]
                        selParts = {}
                        for i = 1, #parts - 1 do selParts[i] = parts[i] end
                    end
                    local byLower = {}
                    for _, n in ipairs(values) do byLower[string.lower(tostring(n))] = tostring(n) end
                    local newCur = {}
                    for _, tok in ipairs(selParts) do
                        local real = byLower[string.lower(tok)]
                        if real then newCur[real] = true end
                    end
                    local changed = false
                    for k in pairs(cur) do
                        if not newCur[k] then cur[k] = nil; changed = true end
                    end
                    for k in pairs(newCur) do
                        if not cur[k] then cur[k] = true; changed = true end
                    end
                    filterText = filt
                    if changed then
                        dropObj.Value = selectedList()
                        fireCallback()
                    end
                    return changed
                end

                dropObj = {
                    Type = "Dropdown",
                    Value = multi and selectedList() or cur,
                    Values = values,
                    Multi = multi,
                    SetValue = function(self, v)
                        if v == nil then return end
                        if multi then
                            cur = {}
                            if type(v) == "table" then
                                for _, x in ipairs(v) do cur[tostring(x)] = true end
                            else
                                cur[tostring(v)] = true
                            end
                            self.Value = selectedList()
                        else
                            cur = v
                            self.Value = v
                        end
                        setSearchDisplay()
                        rebuildOptions()
                        fireCallback()
                    end,
                    GetValue = function(self)
                        if multi then return selectedList() end
                        return cur
                    end,
                    SetValues = function(self, newValues)
                        values = newValues or values or {}
                        self.Values = values
                        rebuildOptions()
                    end,
                }

                setSearchDisplay()

                searchBox.Focused:Connect(function()
                    if not multi then
                        suppressText = true
                        searchBox.Text = ""
                        filterText = ""
                        suppressText = false
                    end
                    setDropOpen(true)
                end)
                searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                    if suppressText then return end
                    if multi then
                        applyMultiFromText(searchBox.Text)
                    else
                        filterText = searchBox.Text
                    end
                    if not dropOpen then setDropOpen(true) else rebuildOptions() end
                end)
                UserInputService.InputBegan:Connect(function(inp)
                    if not dropOpen then return end
                    if inp.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                    local pos = inp.Position
                    local function inside(gui)
                        if not gui or not gui.Parent then return false end
                        local a, s = gui.AbsolutePosition, gui.AbsoluteSize
                        return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
                    end
                    if not inside(searchBox) and not inside(dropList) then
                        setDropOpen(false)
                    end
                end)

                if opts.Flag then
                    Library.Options[opts.Flag] = dropObj
                end
                return dropObj
            end

            function group:AddColorPicker(text, opts)
                return self:AddLabel(text):AddColorPicker(opts)
            end

            return group
        end

        function tab:AddLeftGroupbox(t) return makeGroupbox(t, true) end
        function tab:AddRightGroupbox(t) return makeGroupbox(t, false) end
        function tab:AddLeftTabbox(t) return makeGroupbox(t, true) end
        function tab:AddRightTabbox(t) return makeGroupbox(t, false) end

        return tab
    end

    Window.ApplyTheme()
    Window.Theme = Theme
    Window.DefaultTheme = DefaultTheme
    Window.SettingsManager = SettingsManager.new(Window)

    
    
    local lastMainPos = nil
    local lastMainSize = nil
    dockESPPreview = function()
        if not (MainWindow.Parent and ESPFrame.Parent) then return end
        if not PreviewLocked then return end
        local mp = MainWindow.AbsolutePosition
        local ms = MainWindow.AbsoluteSize
        if ms.X < 1 or ms.Y < 1 then return end

        -- Never larger than the main window
        local maxW = math.max(120, ms.X)
        local maxH = math.max(160, ms.Y)
        local previewW = ESPFrame.Size.X.Offset
        local previewH = ESPFrame.Size.Y.Offset
        if previewW < 40 then previewW = math.max(40, ESPFrame.AbsoluteSize.X) end
        if previewH < 40 then previewH = math.max(40, ESPFrame.AbsoluteSize.Y) end
        if previewW < 40 then previewW = 180 end
        if previewH < 40 then previewH = 300 end
        -- Prefer a compact panel; clamp so it cannot exceed main
        previewW = math.clamp(previewW, 140, math.min(220, maxW))
        previewH = math.clamp(previewH, 200, maxH)

        -- Dock to the RIGHT of the main window, vertically centered (level with main)
        local gap = 10
        ESPFrame.AnchorPoint = Vector2.new(0, 0)
        ESPFrame.Size = UDim2.fromOffset(math.floor(previewW + 0.5), math.floor(previewH + 0.5))
        local x = mp.X + ms.X + gap
        local y = mp.Y + (ms.Y - previewH) * 0.5 -- vertically centered with main

        local cam = workspace.CurrentCamera
        local vw = (cam and cam.ViewportSize.X) or 1920
        local vh = (cam and cam.ViewportSize.Y) or 1080
        -- Prefer right side; if it would go off-screen, flip to the left of main
        if x + previewW > vw - 4 then
            x = mp.X - previewW - gap
        end
        if x < 4 then x = 4 end
        if y < 4 then y = 4 end
        if y + previewH > vh - 4 then
            y = math.max(4, vh - previewH - 4)
        end
        -- Absolute screen coords (ESPPreviewGui has IgnoreGuiInset = true)
        ESPFrame.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
        lastMainPos = mp
        lastMainSize = ms
        espUserDragged = false
    end

    -- Only re-dock when main window actually moves/resizes (avoids jump when grabbing)
    MainWindow:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if PreviewLocked then dockESPPreview() end
    end)
    MainWindow:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if PreviewLocked then dockESPPreview() end
    end)
    -- Light heartbeat only when locked, but skip if position already matches (no flicker/jump)
    RunService.Heartbeat:Connect(function()
        if not PreviewLocked or not MainWindow.Parent or not ESPFrame.Parent then return end
        local mp = MainWindow.AbsolutePosition
        local ms = MainWindow.AbsoluteSize
        if lastMainPos and lastMainSize
            and math.abs(mp.X - lastMainPos.X) < 0.5
            and math.abs(mp.Y - lastMainPos.Y) < 0.5
            and math.abs(ms.X - lastMainSize.X) < 0.5
            and math.abs(ms.Y - lastMainSize.Y) < 0.5 then
            return
        end
        dockESPPreview()
    end)

    Window.DockESPPreview = dockESPPreview
    Window.ESPPreviewGui = ESPPreviewGui
    task.defer(dockESPPreview)
    task.defer(applyUIBlur)

    if getgenv then
        pcall(function() getgenv().SecretServicesWindow = Window end)
    end

    return Window
end

local PlayerListState = {
