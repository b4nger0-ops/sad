                local toggleObj = {
                    Type = "Toggle",
                    Value = state,
                    SetValue = nil,
                    GetValue = function() return state end,
                }
                local function set(v, fromKey)
                    state = v
                    toggleObj.Value = state
                    local onCol = state and Theme.UtilityColor or Theme.ToggleOff
                    local strokeCol = state and Theme.UtilityColor or Theme.OutlineColor
                    lbl.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Theme.FontColor
                    if UtilityGradientEnabled then
                        local existing = box:FindFirstChildOfClass("UIGradient")
                        if existing then existing:Destroy() end
                        if state then
                            box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                            local g = Instance.new("UIGradient")
                            g.Color = ColorSequence.new({
                                ColorSequenceKeypoint.new(0, GradientColors[1]),
                                ColorSequenceKeypoint.new(0.5, GradientColors[2]),
                                ColorSequenceKeypoint.new(1, GradientColors[3]),
                            })
                            g.Parent = box
                            table.insert(Window.UtilityGradients, g)
                        else
                            if Library.UIAnim and Library.UIAnim.Enabled then
                                uiTween(box, { BackgroundColor3 = Theme.ToggleOff }, 0.15)
                            else
                                box.BackgroundColor3 = Theme.ToggleOff
                            end
                        end
                    else
                        if Library.UIAnim and Library.UIAnim.Enabled then
                            uiTween(box, { BackgroundColor3 = onCol }, 0.15)
                        else
                            box.BackgroundColor3 = onCol
                        end
                    end
                    if Library.UIAnim and Library.UIAnim.Enabled then
                        uiTween(bs, { Color = strokeCol }, 0.15)
                    else
                        bs.Color = strokeCol
                    end
                    if linkedKb and not fromKey then
                        linkedKb.Toggled = state
                    end
                    if opts.Callback then opts.Callback(state) end
                end
                toggleObj.SetValue = function(_, v) set(v) end
                box.MouseButton1Click:Connect(function() set(not state) end)
                lbl.MouseButton1Click:Connect(function() set(not state) end)
                -- Subtle hover brighten
                row.MouseEnter:Connect(function()
                    if not (Library.UIAnim and Library.UIAnim.Hover and Library.UIAnim.Enabled) then return end
                    if not state then
                        uiTween(lbl, { TextColor3 = Color3.fromRGB(230, 230, 230) }, 0.12)
                    end
                end)
                row.MouseLeave:Connect(function()
                    if not (Library.UIAnim and Library.UIAnim.Hover and Library.UIAnim.Enabled) then return end
                    if not state then
                        uiTween(lbl, { TextColor3 = Theme.FontColor }, 0.12)
                    end
                end)
                registerToggleBox(box, function() return state end)

                local flag = opts.Flag
                if flag then
                    Library.Toggles[flag] = toggleObj
                end

                return {
                    Type = "Toggle",
                    Value = state,
                    Row = row,
                    SetValue = function(_, v) set(v) end,
                    GetValue = function() return state end,
                    SetVisible = function(_, vis)
                        row.Visible = vis and true or false
                        row.Size = vis and UDim2.new(1, 0, 0, rowH) or UDim2.new(1, 0, 0, 0)
