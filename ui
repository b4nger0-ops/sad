            Callback = function()
                local name = listDrop:GetValue()
                if not name or name == "--" then
                    return self:Notify("No config selected")
                end
                local ok, err = safeWrite(self.Folder .. "/settings/autoload.txt", name)
                if not ok then
                    return self:Notify("Failed to set autoload: " .. tostring(err))
                end
                if self.AutoloadLabel and self.AutoloadLabel.SetText then
                    self.AutoloadLabel:SetText("Current autoload config: " .. name)
                end
                self:Notify(string.format('Set "%s" to auto load', name))
            end,
        })

        local autoLabel = section:AddLabel("Current autoload config: none")
        self.AutoloadLabel = autoLabel
        if safeIsFile(self.Folder .. "/settings/autoload.txt") then
            local ok, name = safeRead(self.Folder .. "/settings/autoload.txt")
            if ok and name and name ~= "" then
                name = name:gsub("%s+$", ""):gsub("^%s+", "")
                autoLabel:SetText("Current autoload config: " .. name)
            end
        end

        self:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName" })
    end

    SaveManager:BuildFolderTree()
end

