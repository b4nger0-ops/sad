    local function dupeMethod1()
        local Tool = getValidTool()
        if not Tool then return end
        Tool.Parent = Backpack
        task.wait(0.5)
        local ToolName = Tool.Name
        local ToolId
        local delay = 0.25 + ((math.clamp(getPing(), 0, 300) / 300) * 0.03)
        local conn
        local market = ReplicatedStorage:FindFirstChild("MarketItems")
        if market then
            conn = market.ChildAdded:Connect(function(item)
                if item.Name == ToolName then
                    local owner = item:FindFirstChild("owner")
                    if owner and owner.Value == LocalPlayer.Name then
                        ToolId = item:GetAttribute("SpecialId")
                    end
                end
            end)
        end
        pcall(function() ReplicatedStorage.ListWeaponRemote:FireServer(ToolName, 99999) end)
        task.wait(delay)
        pcall(function() ReplicatedStorage.BackpackRemote:InvokeServer("Store", ToolName) end)
        task.wait(3)
        if ToolId then
            pcall(function() ReplicatedStorage.BuyItemRemote:FireServer(ToolName, "Remove", ToolId) end)
        end
        pcall(function() ReplicatedStorage.BackpackRemote:InvokeServer("Grab", ToolName) end)
        if conn then conn:Disconnect() end
    end

    local function dupeMethod2()
        if Cooldown then return end
        Cooldown = true
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then Cooldown = false return end
        local ToolName = tool.Name
        getgenv().TeleportSettings = { Speed = 0.25 }
        getgenv().StoreDuped = true
        local function enableSwim() getgenv().SwimMethod = true task.wait(1) end
        local function disableSwim() getgenv().SwimMethod = false end
        local function BypassTp(cf)
            local c = LocalPlayer.Character
            if not c or not c:FindFirstChild("HumanoidRootPart") then return end
            enableSwim()
            task.wait(getgenv().TeleportSettings.Speed)
            c.HumanoidRootPart.CFrame = cf + Vector3.new(2, 0, 0)
            task.delay(0.25, disableSwim)
        end
        local function FindNearbySafe()
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return nil end
            local closestSafe, closestDist = nil, 5
            for _, safe in ipairs(Workspace:GetDescendants()) do
                if safe.Name == "Safe" and safe:IsA("Model") then
                    local part = safe:FindFirstChildWhichIsA("BasePart")
                    if part then
                        local dist = (root.Position - part.Position).Magnitude
                        if dist < closestDist then closestDist = dist closestSafe = safe end
                    end
                end
            end
            return closestSafe
        end
        local function SafeDupeOnce(toolName, targetSafe)
            if not targetSafe or not toolName then return end
            local Character = LocalPlayer.Character
            if not Character then return end
            local InventoryRemote = ReplicatedStorage:FindFirstChild("Inventory")
            local BackpackRemote = ReplicatedStorage:FindFirstChild("BackpackRemote")
            if Character:FindFirstChildOfClass("Humanoid") then Character.Humanoid:UnequipTools() end
            if BackpackRemote then task.spawn(function() BackpackRemote:InvokeServer("Store", toolName) end) end
            if InventoryRemote then task.spawn(function() InventoryRemote:FireServer("Change", toolName, "Backpack", targetSafe) end) end
            task.wait(2)
            if BackpackRemote then BackpackRemote:InvokeServer("Grab", toolName) end
            if not getgenv().StoreDuped and InventoryRemote then
                InventoryRemote:FireServer("Change", toolName, "Inv", targetSafe)
            end
        end
        local safeToUse = FindNearbySafe()
        if not safeToUse then
            pcall(function()
                safeToUse = Workspace:WaitForChild("HomeDoorSS", 2):WaitForChild("HomeDoor"):WaitForChild("Safe")
            end)
            if not safeToUse then Cooldown = false return end
            if not AtSafe then
                OriginalCFrame = char:WaitForChild("HumanoidRootPart").CFrame
                local safePart = safeToUse:FindFirstChildWhichIsA("BasePart")
                if not safePart then Cooldown = false return end
                BypassTp(safePart.CFrame + Vector3.new(0, 0.5, 0))
                AtSafe = true
                task.wait(1)
            end
            SafeDupeOnce(ToolName, safeToUse)
        else
            SafeDupeOnce(ToolName, safeToUse)
        end
        task.wait(0.5)
        local backpackTool = LocalPlayer.Backpack:FindFirstChild(ToolName)
        if backpackTool and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:EquipTool(backpackTool)
        end
        Cooldown = false
        task.wait(3)
    end

    local function ReturnToOriginal()
        if AtSafe and OriginalCFrame then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
