local function PlayerESP(plr)
    if not ESPAlive then return end
    if plr == LocalPlayer then return end
    clearPlayer(plr.Name)
    Drawn[plr.Name] = {}
    RotationAngles[plr.Name] = 0
    RotationLastTime[plr.Name] = tick()

    local nameTxt = CreateText()
    local weaponTxt = CreateText()
    local distTxt = CreateText()
    local healthTxt = CreateText()
    local enemyTxt = CreateText()
    enemyTxt.TextColor3 = Color3.fromRGB(255, 50, 50)
    enemyTxt.Text = "Enemy"
    local corners = makeCorners()
    local hOutline, hBack, hBar, healthGradient = createHealthParts()

    -- Skeleton lines + head circle
    local skelLines = {}
    for boneName in pairs(SKELETON_ORDER) do
        local f = Create("Frame", {
            BackgroundColor3 = SkeletonColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Visible = false,
            ZIndex = 25,
        })
        skelLines[boneName] = f
        table.insert(Drawn[plr.Name], f)
    end
    local headCircle = Create("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Visible = false,
        ZIndex = 26,
    })
    local headStroke = Instance.new("UIStroke")
    headStroke.Color = HeadCircleColor
    headStroke.Thickness = 1.5
    headStroke.Parent = headCircle
    Instance.new("UICorner", headCircle).CornerRadius = UDim.new(1, 0)
    table.insert(Drawn[plr.Name], headCircle)

    local function setSkelLine(frame, x1, y1, x2, y2)
        local dx, dy = x2 - x1, y2 - y1
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 1 then
            frame.Visible = false
            return
        end
        frame.Size = UDim2.fromOffset(math.max(1, len), 1.5)
        frame.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
        frame.Rotation = math.deg(math.atan2(dy, dx))
        frame.BackgroundColor3 = SkeletonColor
        frame.Visible = true
    end

    local box = Create("Frame", {BorderSizePixel = 0, ZIndex = 2, Visible = false})
    local boxGrad = Instance.new("UIGradient")
    boxGrad.Rotation = -45
    boxGrad.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Transparency = 0
    boxStroke.Thickness = 1
    boxStroke.Parent = box

    local boxStrokeGrad = Instance.new("UIGradient")
    boxStrokeGrad.Rotation = -45
    boxStrokeGrad.Parent = boxStroke

    for _, obj in {nameTxt, weaponTxt, distTxt, healthTxt, enemyTxt, hOutline, hBack, hBar, box} do
        table.insert(Drawn[plr.Name], obj)
    end
    for _, c in ipairs(corners) do table.insert(Drawn[plr.Name], c) end

    BoxObjects[plr.Name] = {box = box, grad = boxGrad, stroke = boxStroke, strokeGrad = boxStrokeGrad}

    local function hideAllDrawn()
        for _, v in ipairs(Drawn[plr.Name]) do
            if v and typeof(v) == "Instance" and v:IsA("GuiObject") then
                v.Visible = false
            end
        end
    end

    local function update()
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local curHp, maxHp = getPlayerHealthValues(plr, hum)
        local alive = char and root and hum and (curHp > 0 or hum.Health > 0)
        if not alive then
            hideAllDrawn()
            return
        end

        
        if PlayerListState.HideFriendly and isWhitelisted(plr) then
            hideAllDrawn()
            applyHighlightChams(char, false)
            return
        elseif Toggles.HighlightChams then
            local existing = char:FindFirstChild("ThermalHighlight")
            if not existing then
                applyHighlightChams(char, true)
            end
        else
            applyHighlightChams(char, false)
        end

        -- Viewport space (MasterGui.IgnoreGuiInset = true) so boxes/skeleton share the same origin
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if not onScreen or screenPos.Z > MaxDistance or screenPos.Z < 1 then
            hideAllDrawn()
            return
        end

        
        -- FOV-aware box size so scoped / zoomed FOV does not collapse or explode boxes.
        -- Project real head/feet when possible; fall back to distance * tan(halfFOV) formula.
        local centerX = screenPos.X
        local topY, bottomY, w, h
        do
            local head = char:FindFirstChild("Head")
            local foot = char:FindFirstChild("LeftFoot")
                or char:FindFirstChild("RightFoot")
                or char:FindFirstChild("Left Leg")
                or char:FindFirstChild("Right Leg")
                or char:FindFirstChild("LeftLowerLeg")
                or char:FindFirstChild("RightLowerLeg")
            local topWorld, botWorld
            if head and head:IsA("BasePart") then
                topWorld = (head.CFrame * CFrame.new(0, head.Size.Y * 0.5, 0)).Position
            else
                topWorld = root.Position + Vector3.new(0, 3, 0)
            end
            if foot and foot:IsA("BasePart") then
                botWorld = (foot.CFrame * CFrame.new(0, -foot.Size.Y * 0.5, 0)).Position
            else
                botWorld = root.Position - Vector3.new(0, 3, 0)
            end
            local spTop, onTop = Camera:WorldToViewportPoint(topWorld)
            local spBot, onBot = Camera:WorldToViewportPoint(botWorld)
            if onTop and onBot and spTop.Z > 0 and spBot.Z > 0 then
                topY = math.min(spTop.Y, spBot.Y)
                bottomY = math.max(spTop.Y, spBot.Y)
                h = math.max(4, bottomY - topY) * 1.08
                -- width from projected height aspect (typical human ~0.45–0.55)
                w = math.max(4, h * 0.52)
                -- small vertical pad so box wraps head/feet cleanly
                local pad = h * 0.04
                topY = topY - pad
                bottomY = bottomY + pad
                h = bottomY - topY
            else
                local hrpSizeY = root.Size and root.Size.Y or 2
                local halfFov = math.rad(math.clamp(Camera.FieldOfView, 1, 120) * 0.5)
                local tanHalf = math.tan(halfFov)
                if tanHalf < 1e-4 then tanHalf = 1e-4 end
                local scaleFactor = (hrpSizeY * Camera.ViewportSize.Y) / (screenPos.Z * 2 * tanHalf)
                w = 3 * scaleFactor
                h = 4.5 * scaleFactor
                topY = screenPos.Y - h / 2
                bottomY = screenPos.Y + h / 2
            end
        end
        
        local baseTextSize = 11
        local lineH = baseTextSize + 5

        local isEnemy = isBlacklisted(plr)
        local enemyColor = Color3.fromRGB(255, 50, 50)
        local normalText = TextColor
        local drawColor = isEnemy and enemyColor or normalText
        local boxCornerColor = isEnemy and enemyColor or ESPColors.BoxCorner
        local fillC1 = isEnemy and Color3.fromRGB(255, 40, 40) or GradientColors.FullBoxFill.Color1
        local fillC2 = isEnemy and Color3.fromRGB(80, 0, 0) or GradientColors.FullBoxFill.Color2
        local outlineC1 = isEnemy and Color3.fromRGB(255, 60, 60) or GradientColors.FullBoxOutline.Color1
        local outlineC2 = isEnemy and Color3.fromRGB(40, 0, 0) or GradientColors.FullBoxOutline.Color2

        
        local Layout = Library.ESPLayout

        local function vAlignToT(vAlign)
            if vAlign == "Top" then return 0
            elseif vAlign == "Quarter" then return 0.25
            elseif vAlign == "Half" then return 0.5
            elseif vAlign == "ThreeQuarters" then return 0.75
            else return 1 end
        end
        local function alignToT(align)
            if align == "Left" then return 0
            elseif align == "Right" then return 1
            else return 0.5 end
        end

        local leftX = centerX - w / 2
        local boxBottom = bottomY

        local function stackIndexFor(key, side, align, vAlign)
            local keys = { "Name", "Weapon", "Distance", "HealthText", "HealthBar" }
            local flags = {
                Name = Toggles.Name,
                Weapon = Toggles.Weapon,
                Distance = Toggles.Distance,
                HealthText = Toggles.HealthText,
                HealthBar = Toggles.HealthBar,
            }
            local myL = Layout[key]
            local myOrder = (myL and myL.order) or 0
            
            if myOrder == 0 then
                for i, k in ipairs(keys) do
                    if k == key then myOrder = i break end
                end
            end
            local idx = 0
            for _, k in ipairs(keys) do
                if k ~= key then
                    local L = Layout[k]
                    if flags[k] and L and L.side == side and L.align == align and L.vAlign == vAlign then
                        local o = L.order or 0
                        if o == 0 then
                            for i, kk in ipairs(keys) do
                                if kk == k then o = i break end
                            end
                        end
                        if o < myOrder then
                            idx = idx + 1
                        end
                    end
                end
            end
            return idx
        end

        local function placeText(label, key, text, color)
            local L = Layout[key] or { side = "Top", align = "Middle", vAlign = "Top" }
            local side = L.side or "Top"
            local pad = 6
            local si = stackIndexFor(key, side, L.align, L.vAlign)
            local x, y
            local anchor = Vector2.new(0.5, 0.5)
            local xAlign = Enum.TextXAlignment.Center
            local align = L.align or "Middle"

            
            local textW = math.max(8, getTextWidth(tostring(text), baseTextSize) + 2)
            local textH = baseTextSize + 4

            if side == "Top" then
                local t = alignToT(align)
                x = leftX + w * t
                y = topY - pad - baseTextSize * 0.5 - si * lineH
                if align == "Left" then
                    anchor = Vector2.new(0, 0.5)
                    xAlign = Enum.TextXAlignment.Left
                elseif align == "Right" then
                    anchor = Vector2.new(1, 0.5)
                    xAlign = Enum.TextXAlignment.Right
                end
            elseif side == "Bottom" then
                local t = alignToT(align)
                x = leftX + w * t
                y = boxBottom + pad + baseTextSize * 0.5 + si * lineH
                if align == "Left" then
                    anchor = Vector2.new(0, 0.5)
                    xAlign = Enum.TextXAlignment.Left
                elseif align == "Right" then
                    anchor = Vector2.new(1, 0.5)
                    xAlign = Enum.TextXAlignment.Right
                end
            elseif side == "Left" then
                local t = vAlignToT(L.vAlign)
                x = leftX - pad
                y = topY + h * t
                anchor = Vector2.new(1, 0.5)
                xAlign = Enum.TextXAlignment.Right
                if key == "HealthText" and Toggles.HealthBar then
                    local hb = Layout.HealthBar or { side = "Right" }
                    local hs = hb.side
                    if hs ~= "Left" and hs ~= "Right" then hs = "Right" end
                    if hs == "Left" then
                        -- bar at leftX - 6 - barW; hug its outer (left) edge
                        local barW = Settings.HealthWidth or 2.5
                        x = leftX - 6 - barW - 1
                    end
                end
            else 
                local t = vAlignToT(L.vAlign)
                x = leftX + w + pad
                y = topY + h * t
                anchor = Vector2.new(0, 0.5)
                xAlign = Enum.TextXAlignment.Left
                if key == "HealthText" and Toggles.HealthBar then
                    local hb = Layout.HealthBar or { side = "Right" }
                    local hs = hb.side
                    if hs ~= "Left" and hs ~= "Right" then hs = "Right" end
                    if hs == "Right" then
                        -- bar at leftX + w + 4; hug its outer (right) edge
                        local barW = Settings.HealthWidth or 2.5
                        x = leftX + w + 4 + barW + 1
                    end
                end
            end

            label.Text = text
            label.Font = Enum.Font.Code
            label.TextColor3 = color
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.TextSize = baseTextSize
            label.AnchorPoint = anchor
            label.TextXAlignment = xAlign
            label.Size = UDim2.fromOffset(textW, textH)
            label.Position = UDim2.new(0, x, 0, y)
            label.Visible = true
        end

        
        if PlayerListState.MarkEnemy and isEnemy then
            enemyTxt.Text = "Enemy"
            enemyTxt.Font = Enum.Font.Code
            enemyTxt.TextColor3 = enemyColor
            enemyTxt.TextStrokeTransparency = 0
            enemyTxt.TextStrokeColor3 = Color3.new(0, 0, 0)
            enemyTxt.TextSize = baseTextSize
            enemyTxt.AnchorPoint = Vector2.new(0.5, 0.5)
            enemyTxt.Position = UDim2.new(0, centerX, 0, topY - (lineH * 2 + 6))
            enemyTxt.Visible = true
        else
            enemyTxt.Visible = false
        end

        if Toggles.Name then
            placeText(nameTxt, "Name", plr.Name, isEnemy and enemyColor or NameColor)
        else
            nameTxt.Visible = false
        end

        if Toggles.Weapon then
            local itemName = getEquippedItemName(plr, char)
            placeText(weaponTxt, "Weapon", itemName, isEnemy and enemyColor or ItemColor)
        else
            weaponTxt.Visible = false
        end

        if Toggles.Distance then
            placeText(distTxt, "Distance", math.floor(dist) .. " studs", isEnemy and enemyColor or DistanceColor)
        else
            distTxt.Visible = false
        end

        
        if Toggles.HealthBar then
            local hpPct = math.clamp(curHp / math.max(maxHp, 1), 0, 1)
            local fillH = h * hpPct
            local barW = Settings.HealthWidth
            local hLayout = Layout.HealthBar or { side = "Right" }
            local hSide = hLayout.side
            if hSide ~= "Left" and hSide ~= "Right" then
                hSide = "Right"
            end
            local barX
            if hSide == "Left" then
                barX = leftX - 6 - barW
            else
                barX = leftX + w + 4
            end
            local barY = topY

            hOutline.Position = UDim2.new(0, barX - 1, 0, barY - 1)
            hOutline.Size = UDim2.new(0, barW + 2, 0, h + 2)
            hBack.Position = UDim2.new(0, barX, 0, barY)
            hBack.Size = UDim2.new(0, barW, 0, h)
            hBar.Position = UDim2.new(0, barX, 0, barY + h - fillH)
            hBar.Size = UDim2.new(0, barW, 0, fillH)
            healthGradient.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, GradientColors.Health.Color1),
                ColorSequenceKeypoint.new(1, GradientColors.Health.Color2)
            }
            healthGradient.Enabled = true
            hBar.Visible = true
            hOutline.Visible = true
            hBack.Visible = true
        else
            hOutline.Visible = false
            hBack.Visible = false
            hBar.Visible = false
            healthGradient.Enabled = false
        end

        
        if Toggles.HealthText then
            local hi = HealthTextHighColor or Color3.fromRGB(0, 255, 0)
            local lo = HealthTextLowColor or Color3.fromRGB(255, 0, 0)
            local hpColor = (curHp >= maxHp * 0.5) and hi or lo
            placeText(healthTxt, "HealthText", tostring(math.floor(curHp + 0.5)), hpColor)
        else
            healthTxt.Visible = false
        end

        local useBox = Toggles.Box
        local useCorner = useBox and Toggles.BoxCorner
        local useFill = Toggles.BoxFill

        -- Fill (optional) sits behind outline / corners
        if useFill then
            local obj = BoxObjects[plr.Name]
            obj.box.Position = UDim2.new(0, centerX - w/2, 0, topY)
            obj.box.Size = UDim2.new(0, w, 0, h)
            obj.box.Visible = true
            obj.box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            obj.box.BackgroundTransparency = Settings.BoxFillTransparency
            obj.box.BorderSizePixel = 0
            obj.stroke.Enabled = false
            obj.grad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, fillC1),
                ColorSequenceKeypoint.new(1, fillC2)
            }
            local now = tick()
            local last = RotationLastTime[plr.Name] or now
            local delta = now - last
            RotationAngles[plr.Name] = (RotationAngles[plr.Name] + delta * Settings.FullBoxRotationSpeed) % 360
            RotationLastTime[plr.Name] = now
            obj.grad.Rotation = RotationAngles[plr.Name]
            obj.grad.Enabled = true
            obj.strokeGrad.Enabled = false
        elseif useBox and not useCorner then
            -- Solid white outline box (matches corner style colors)
            local obj = BoxObjects[plr.Name]
            obj.box.Position = UDim2.new(0, centerX - w/2, 0, topY)
            obj.box.Size = UDim2.new(0, w, 0, h)
            obj.box.Visible = true
            obj.box.BackgroundTransparency = 1
            obj.box.BorderSizePixel = 0
            obj.stroke.Enabled = true
            obj.stroke.Thickness = math.max(1, Settings.BoxCornerThickness)
            obj.stroke.Color = boxCornerColor
            obj.stroke.Transparency = 0
            obj.grad.Enabled = false
            obj.strokeGrad.Enabled = false
        else
            if BoxObjects[plr.Name] then
                BoxObjects[plr.Name].box.Visible = false
                BoxObjects[plr.Name].stroke.Enabled = false
            end
        end

        -- When both fill + full outline wanted: show fill then draw stroke on same box
        if useFill and useBox and not useCorner then
            local obj = BoxObjects[plr.Name]
            obj.stroke.Enabled = true
            obj.stroke.Thickness = math.max(1, Settings.BoxCornerThickness)
            obj.stroke.Color = boxCornerColor
            obj.stroke.Transparency = 0
            obj.strokeGrad.Enabled = false
        end

        if useCorner then
            local arm = math.max(4, w * 0.22)
            local thick = Settings.BoxCornerThickness
            local positions = {
                {centerX - w/2, topY, arm, thick},
                {centerX - w/2, topY, thick, arm},
                {centerX + w/2 - arm, topY, arm, thick},
                {centerX + w/2 - thick, topY, thick, arm},
                {centerX - w/2, bottomY - thick, arm, thick},
                {centerX - w/2, bottomY - arm, thick, arm},
                {centerX + w/2 - arm, bottomY - thick, arm, thick},
                {centerX + w/2 - thick, bottomY - arm, thick, arm}
            }
            for i = 1, 8 do
                local x,y,sx,sy = unpack(positions[i])
                local f = corners[i]
                f.BackgroundColor3 = boxCornerColor
                f.Position = UDim2.new(0,x,0,y)
                f.Size = UDim2.new(0,sx,0,sy)
                f.Visible = true
            end
        else
            for _, f in ipairs(corners) do f.Visible = false end
        end

        -- Skeleton + head circle (same Viewport space as boxes)
        if Toggles.Skeleton then
            local cam = Camera
            local isR15 = char:FindFirstChild("UpperTorso") ~= nil

            local function boneWorldPos(part)
                if not part or not part:IsA("BasePart") then return nil end
                -- Prefer common joint attachments for tighter alignment on R15
                local prefer = {
                    "NeckRigAttachment", "WaistRigAttachment",
                    "LeftShoulderRigAttachment", "RightShoulderRigAttachment",
                    "LeftElbowRigAttachment", "RightElbowRigAttachment",
                    "LeftWristRigAttachment", "RightWristRigAttachment",
                    "LeftHipRigAttachment", "RightHipRigAttachment",
                    "LeftKneeRigAttachment", "RightKneeRigAttachment",
                    "LeftAnkleRigAttachment", "RightAnkleRigAttachment",
                }
                for _, attName in ipairs(prefer) do
                    local att = part:FindFirstChild(attName)
                    if att and att:IsA("Attachment") then
                        return att.WorldPosition
                    end
                end
                return part.Position
            end

            for boneName, parentName in pairs(SKELETON_ORDER) do
                local line = skelLines[boneName]
                if not line then continue end
                -- R6 uses Head->Torso; R15 uses UpperTorso->Head (already in map)
                if boneName == "Head" and isR15 then
                    line.Visible = false
                    continue
                end
                if (boneName == "UpperTorso" or boneName == "LowerTorso") and not isR15 then
                    line.Visible = false
                    continue
                end
                local part = char:FindFirstChild(boneName)
                local parent = char:FindFirstChild(parentName)
                if part and parent and part:IsA("BasePart") and parent:IsA("BasePart") then
                    local w1 = boneWorldPos(part)
                    local w2 = boneWorldPos(parent)
                    if w1 and w2 then
                        local p1, on1 = cam:WorldToViewportPoint(w1)
                        local p2, on2 = cam:WorldToViewportPoint(w2)
                        if on1 and on2 and p1.Z > 0 and p2.Z > 0 then
                            setSkelLine(line, p1.X, p1.Y, p2.X, p2.Y)
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
            local head = char:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                local hp, onH = cam:WorldToViewportPoint(head.Position)
                local top = cam:WorldToViewportPoint((head.CFrame * CFrame.new(0, head.Size.Y * 0.5, 0)).Position)
                if onH and hp.Z > 0 then
                    local radius = math.clamp(math.abs(top.Y - hp.Y) * 1.15, 4, 40)
                    headCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
                    headCircle.Position = UDim2.fromOffset(hp.X, hp.Y)
                    headStroke.Color = HeadCircleColor
                    headCircle.Visible = true
                else
                    headCircle.Visible = false
                end
            else
                headCircle.Visible = false
            end
        else
            for _, line in pairs(skelLines) do
                line.Visible = false
            end
            headCircle.Visible = false
        end

        
        -- Highlight fill is driven by the always-on gradient wave loop; keep outline off
        if Toggles.HighlightChams then
            local hl = char:FindFirstChild("ThermalHighlight")
            if hl then
                hl.OutlineTransparency = 1
            end
        end
    end

    local renderConn = RunService.RenderStepped:Connect(update)
    table.insert(Drawn[plr.Name], renderConn)
    table.insert(Connections, renderConn)

    local charAddedConn = plr.CharacterAdded:Connect(function(c)
        task.wait(0.1)
        if Toggles.HighlightChams then applyHighlightChams(c, true) end
        if Toggles.Chams then
            vcDestroyEntry(plr)
            vcEnsureEntry(plr)
        end
        update()
    end)
    table.insert(Drawn[plr.Name], charAddedConn)
    table.insert(Connections, charAddedConn)

    if plr.Character and Toggles.HighlightChams then applyHighlightChams(plr.Character, true) end
end

