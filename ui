    local function isCharacterModel(obj)
        if not obj or not obj:IsA("Model") then return false end
        local root = obj:FindFirstChild("HumanoidRootPart")
            or obj:FindFirstChild("Torso")
            or obj:FindFirstChild("UpperTorso")
            or obj.PrimaryPart
        if not root or not root:IsA("BasePart") then return false end
        local hasHead = obj:FindFirstChild("Head") ~= nil
        local hasTorso = obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso")
        local hasLimb = obj:FindFirstChild("LeftUpperArm") or obj:FindFirstChild("Left Arm")
            or obj:FindFirstChild("RightUpperArm") or obj:FindFirstChild("Right Arm")
        
        return hasHead and (hasTorso or hasLimb)
    end

    local function findAllCharacterModels()
        local seen = {}
        local list = {} 

        local function add(obj, score, label)
            if not isCharacterModel(obj) then return end
            if seen[obj] then
                
                for _, e in ipairs(list) do
                    if e.model == obj and score > e.score then
                        e.score = score
                        e.label = label or e.label
                    end
                end
                return
            end
            seen[obj] = true
            table.insert(list, {
                model = obj,
                score = score,
                label = label or obj.Name,
            })
        end

        local lp = Players.LocalPlayer

        
        if lp then
            local mine = workspace:FindFirstChild(lp.Name)
            if mine then
                add(mine, 300, "workspace." .. lp.Name)
                
                if mine:IsA("Folder") or mine:IsA("Model") then
                    for _, ch in ipairs(mine:GetChildren()) do
                        if ch:IsA("Model") then
                            add(ch, 290, "workspace." .. lp.Name .. "." .. ch.Name)
                        end
                    end
                end
            end
            
            if lp.Character then
                add(lp.Character, 250, "Players." .. lp.Name .. ".Character")
            end
        end

        
        for _, p in ipairs(Players:GetPlayers()) do
            local direct = workspace:FindFirstChild(p.Name)
            if direct then
                add(direct, (p == lp) and 200 or 180, "workspace." .. p.Name)
            end
            local pf = workspace:FindFirstChild("Players")
            if pf then
                local nested = pf:FindFirstChild(p.Name)
                if nested then
                    add(nested, (p == lp) and 195 or 175, "workspace.Players." .. p.Name)
                end
            end
            
            for _, folderName in ipairs({ "Characters", "Character", "PlayerCharacters", "Entities", "Units" }) do
                local f = workspace:FindFirstChild(folderName)
                if f then
                    local m = f:FindFirstChild(p.Name)
                    if m then
                        add(m, (p == lp) and 190 or 170, "workspace." .. folderName .. "." .. p.Name)
                    end
                end
            end
        end

        
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                add(p.Character, (p == lp) and 160 or 150, "Players." .. p.Name .. ".Character")
            end
        end

        
        for _, child in ipairs(workspace:GetChildren()) do
            if child:IsA("Model") then
                add(child, 90, "workspace." .. child.Name)
            elseif child:IsA("Folder") or child:IsA("Configuration") then
                for _, sub in ipairs(child:GetChildren()) do
                    if sub:IsA("Model") then
                        add(sub, 80, "workspace." .. child.Name .. "." .. sub.Name)
                    end
                end
            end
        end
        for _, m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") then
                add(m, 60, m:GetFullName())
            end
        end

        
        local rs = game:GetService("ReplicatedStorage")
        local rsFolders = {
            "Characters", "Character", "PlayerModels", "Models", "Assets",
            "Storage", "Modules", "Resources", "Prefabs", "Rigs", "NPCs",
            "Entities", "Shared", "Game", "Content",
        }
        for _, fname in ipairs(rsFolders) do
            local f = rs:FindFirstChild(fname, true)
            if f then
                for _, m in ipairs(f:GetDescendants()) do
                    if m:IsA("Model") then
                        add(m, 70, "RS." .. fname .. "." .. m.Name)
                    end
                end
                if f:IsA("Model") then
                    add(f, 75, "RS." .. fname)
                end
            end
        end
        for _, m in ipairs(rs:GetDescendants()) do
            if m:IsA("Model") then
                add(m, 50, "RS." .. m.Name)
            end
        end

        
        local okSP, sp = pcall(function() return game:GetService("StarterPlayer") end)
        if okSP and sp then
            local sc = sp:FindFirstChild("StarterCharacter")
            if sc then add(sc, 100, "StarterPlayer.StarterCharacter") end
        end

        
        local okSS, ss = pcall(function() return game:GetService("ServerStorage") end)
        if okSS and ss then
            for _, m in ipairs(ss:GetDescendants()) do
