    local function applyLayoutToLabel(key, label, box, stackIndex)
        local layout = ESPLayout[key]
        if not layout then return end
        local textH = 16
        local textSize = label.TextSize or 12
        local raw = label.Text or ""
        local textW = math.max(8, getTextWidth(raw, textSize) + 2)
        label.Size = UDim2.fromOffset(textW, textH)
        local x, y, anchor = layoutToPos(layout, box, textW, textH, stackIndex)
        
        if key == "HealthText" and ESPState.HealthBar and (layout.side == "Left" or layout.side == "Right") then
            local barSide = (ESPLayout.HealthBar and ESPLayout.HealthBar.side) or "Right"
            if barSide ~= "Left" and barSide ~= "Right" then barSide = "Right" end
            if barSide == layout.side then
                -- Match live bar placement: outer edge of bar + 1px (same tightness as box text pad)
                local barGap = 5
                local barW = 3
                local hug = 1
                if layout.side == "Left" then
                    x = box.leftX - barGap - barW - hug
                else
                    x = box.leftX + box.boxW + barGap + barW + hug
                end
            end
        end
        label.AnchorPoint = anchor
        label.Position = UDim2.fromOffset(x, y)
        if layout.side == "Left" then
            label.TextXAlignment = Enum.TextXAlignment.Right
        elseif layout.side == "Right" then
            label.TextXAlignment = Enum.TextXAlignment.Left
        elseif layout.align == "Left" then
            label.TextXAlignment = Enum.TextXAlignment.Left
        elseif layout.align == "Right" then
            label.TextXAlignment = Enum.TextXAlignment.Right
        else
            label.TextXAlignment = Enum.TextXAlignment.Center
        end
    end

    local function elementEnabled(k)
        if k == "Name" then return ESPState.Name end
        if k == "Weapon" then return ESPState.Weapon end
        if k == "Distance" then return ESPState.Distance end
        if k == "HealthText" then return ESPState.HealthText end
        if k == "HealthBar" then return ESPState.HealthBar end
        return false
    end

    local function stackIndexFor(key, side, align, vAlign)
        
        
        local keys = { "Name", "Weapon", "Distance", "HealthText", "HealthBar" }
        local myOrder = LayoutStackOrder[key] or 0
        local idx = 0
        for _, k in ipairs(keys) do
            if k ~= key then
                local L = ESPLayout[k]
                if elementEnabled(k) and L and L.side == side and L.align == align and L.vAlign == vAlign then
                    local o = LayoutStackOrder[k] or 0
                    if o < myOrder then
                        idx = idx + 1
                    end
                end
            end
        end
        return idx
    end

    local function updateESPOverlay()
        local box = getBoxMetrics()
        local vp = box.vp
        if vp.X < 1 or vp.Y < 1 then return end

        local boxW, boxH, cx, topY, bottomY, leftX =
            box.boxW, box.boxH, box.cx, box.topY, box.bottomY, box.leftX

        
        -- Match real ESP: Box (outline), BoxCorner (corners instead of full outline), BoxFill (fill)
        local useBox = ESPState.Box or ESPState.BoxFull
        local useCorner = useBox and ESPState.BoxCorner
        local useFill = ESPState.BoxFill
        local outlineColor = ESPState.BoxCornerColor or Color3.fromRGB(255, 255, 255)
        local thick = math.max(1, ESPState.BoxThickness or 1.5)

        local showFullOutline = useBox and not useCorner
        local showAnyBoxFrame = useFill or showFullOutline
        FullBox.Visible = showAnyBoxFrame
        if showAnyBoxFrame then
            FullBox.Position = UDim2.fromOffset(leftX, topY)
            FullBox.Size = UDim2.fromOffset(boxW, boxH)
            if useFill then
                FullBox.BackgroundTransparency = ESPState.BoxFillTransparency or 0.75
                FullBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                FullBoxGrad.Enabled = true
                FullBoxGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, ESPState.FillGrad1),
                    ColorSequenceKeypoint.new(1, ESPState.FillGrad2),
                })
            else
                FullBox.BackgroundTransparency = 1
                FullBoxGrad.Enabled = false
            end
            if showFullOutline then
                FullBoxStroke.Enabled = true
                FullBoxStroke.Thickness = thick
                FullBoxStroke.Color = outlineColor
                FullBoxStroke.Transparency = 0
                FullBoxStrokeGrad.Enabled = false
            else
                -- fill only (corners handle outline) — no solid stroke
                FullBoxStroke.Enabled = false
                FullBoxStrokeGrad.Enabled = false
            end
        else
            FullBoxStroke.Enabled = false
            FullBoxGrad.Enabled = false
        end

        local showCorners = useCorner
        local arm = math.max(4, boxW * 0.22)
        local positions = {
            {leftX, topY, arm, thick},
            {leftX, topY, thick, arm},
            {leftX + boxW - arm, topY, arm, thick},
            {leftX + boxW - thick, topY, thick, arm},
            {leftX, bottomY - thick, arm, thick},
            {leftX, bottomY - arm, thick, arm},
            {leftX + boxW - arm, bottomY - thick, arm, thick},
            {leftX + boxW - thick, bottomY - arm, thick, arm},
        }
        for i = 1, 8 do
            local x, y, sx, sy = table.unpack(positions[i])
            local f = CornerFrames[i]
            f.Visible = showCorners
            f.BackgroundColor3 = outlineColor
            f.Position = UDim2.fromOffset(x, y)
            f.Size = UDim2.fromOffset(sx, sy)
        end

        
        local showHpBar = ESPState.HealthBar
        HealthOutline.Visible = showHpBar
        HealthBack.Visible = showHpBar
        HealthBar.Visible = showHpBar
        HealthBarHit.Visible = showHpBar
        if showHpBar and not (DragState.active and DragState.key == "HealthBar") then
            local hw = 3
            local hLayout = ESPLayout.HealthBar or { side = "Right" }
            local hSide = hLayout.side
            if hSide ~= "Left" and hSide ~= "Right" then
                hSide = "Right"
            end
            local barX
            if hSide == "Left" then
                barX = leftX - 8
            else
                barX = leftX + boxW + 5
            end
            local fillH = boxH * math.clamp(ESPState.HealthPct, 0, 1)
            HealthOutline.Position = UDim2.fromOffset(barX - 1, topY - 1)
            HealthOutline.Size = UDim2.fromOffset(hw + 2, boxH + 2)
            HealthBack.Position = UDim2.fromOffset(barX, topY)
            HealthBack.Size = UDim2.fromOffset(hw, boxH)
            HealthBar.Position = UDim2.fromOffset(barX, topY + boxH - fillH)
            HealthBar.Size = UDim2.fromOffset(hw, fillH)
            
            HealthBarHit.Position = UDim2.fromOffset(barX - 5, topY)
            HealthBarHit.Size = UDim2.fromOffset(hw + 10, boxH)
            HealthGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, ESPState.HealthLow),
                ColorSequenceKeypoint.new(1, ESPState.HealthHigh),
            })
        end

        
        local function place(key, label, enabled, text)
            label.Visible = enabled
            if not enabled then return end
            label.Text = text
            if DragState.active and DragState.key == key then return end
            local L = ESPLayout[key]
            if not L then return end
            local si = stackIndexFor(key, L.side, L.align, L.vAlign)
            applyLayoutToLabel(key, label, box, si)
        end

        place("Name", NameTxt, ESPState.Name, ESPState.DisplayName or (Players.LocalPlayer and Players.LocalPlayer.Name) or "Player")
        place("Weapon", WeaponTxt, ESPState.Weapon, "None")
        place("Distance", DistTxt, ESPState.Distance, "25 studs")
        place("HealthText", HealthTxt, ESPState.HealthText, tostring(math.floor(ESPState.HealthPct * 100 + 0.5)))
        if ESPState.HealthText then
            HealthTxt.TextColor3 = ESPState.HealthPct >= 0.5 and (ESPState.HealthTextHigh or Color3.fromRGB(0, 255, 0)) or (ESPState.HealthTextLow or Color3.fromRGB(255, 0, 0))
        end

        
        if ChamsHighlight then
            local was = ChamsHighlight.Enabled
            ChamsHighlight.Enabled = ESPState.Chams
            ChamsHighlight.FillColor = ESPState.ChamsFill
            ChamsHighlight.OutlineColor = ESPState.ChamsOutline
            if ChamsHighlight.Adornee ~= dummy and dummy then
                ChamsHighlight.Adornee = dummy
                ChamsHighlight.Parent = dummy
            end
            if was ~= ESPState.Chams and applyPreviewChamsVisual then
                applyPreviewChamsVisual()
            end
        end

        -- Skeleton (same bone map / viewport projection style as real ESP)
        if ESPState.Skeleton and dummy and Cam then
            local isR15 = dummy:FindFirstChild("UpperTorso") ~= nil
            local camVp = Cam.ViewportSize
            local scaleX = (camVp.X > 0) and (vp.X / camVp.X) or 1
            local scaleY = (camVp.Y > 0) and (vp.Y / camVp.Y) or 1
            local skCol = ESPState.SkeletonColor or Color3.fromRGB(255, 255, 255)
            local function bonePos(part)
                if not part or not part:IsA("BasePart") then return nil end
                return part.Position
            end
            local function setLine(frame, x1, y1, x2, y2)
                local dx, dy = x2 - x1, y2 - y1
                local len = math.sqrt(dx * dx + dy * dy)
                if len < 1 then frame.Visible = false return end
                frame.Size = UDim2.fromOffset(math.max(1, len), 1.5)
                frame.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
                frame.Rotation = math.deg(math.atan2(dy, dx))
                frame.BackgroundColor3 = skCol
                frame.Visible = true
            end
            for boneName, parentName in pairs(PREVIEW_SKELETON_ORDER) do
                local line = PreviewSkelLines[boneName]
                if not line then continue end
                if boneName == "Head" and isR15 then line.Visible = false continue end
                if (boneName == "UpperTorso" or boneName == "LowerTorso") and not isR15 then
                    line.Visible = false
                    continue
                end
                local part = dummy:FindFirstChild(boneName)
                local parent = dummy:FindFirstChild(parentName)
                if part and parent and part:IsA("BasePart") and parent:IsA("BasePart") then
                    local w1, w2 = bonePos(part), bonePos(parent)
                    if w1 and w2 then
                        local p1 = Cam:WorldToViewportPoint(w1)
                        local p2 = Cam:WorldToViewportPoint(w2)
                        if p1.Z > 0 and p2.Z > 0 then
                            setLine(line, p1.X * scaleX, p1.Y * scaleY, p2.X * scaleX, p2.Y * scaleY)
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
            local head = dummy:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                local hp = Cam:WorldToViewportPoint(head.Position)
                local top = Cam:WorldToViewportPoint((head.CFrame * CFrame.new(0, head.Size.Y * 0.5, 0)).Position)
                if hp.Z > 0 then
                    local radius = math.clamp(math.abs(top.Y - hp.Y) * scaleY * 1.15, 4, 40)
                    PreviewHeadCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
                    PreviewHeadCircle.Position = UDim2.fromOffset(hp.X * scaleX, hp.Y * scaleY)
                    PreviewHeadStroke.Color = skCol
                    PreviewHeadCircle.Visible = true
                else
                    PreviewHeadCircle.Visible = false
                end
            else
                PreviewHeadCircle.Visible = false
            end
        else
            for _, line in pairs(PreviewSkelLines) do
                line.Visible = false
            end
            PreviewHeadCircle.Visible = false
        end
    end

    
