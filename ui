    local function getIdFromAnimate(animName)
        local key = string.lower(animName or "")
        if key == "" then return nil end
        local animate = getAnimateFolder()
        if not animate then return nil end
        local folder = animate:FindFirstChild(key) or animate:FindFirstChild(animName)
        if not folder then
            for _, ch in ipairs(animate:GetChildren()) do
                if string.lower(ch.Name) == key then
                    folder = ch
                    break
                end
            end
        end
        if not folder then return nil end
        local ids = collectIdsFromAnimateNode(folder)
        return ids[1]
    end

