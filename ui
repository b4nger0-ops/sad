        btn.MouseButton1Click:Connect(function()
            if isToggle then
                state = not state
                paint()
                if opts.Callback then opts.Callback(state) end
            else
                if opts.Callback then opts.Callback() end
            end
        end)

        if isToggle and opts.Flag then
            local obj = {
