                                -- also try loadstring("return " .. name)
                                local ok2, val2 = pcall(function()
                                    local f = loadstring("return " .. name)
                                    if f then return f() end
                                    return nil
                                end)
                                if ok2 and val2 ~= nil then
                                    okTest = true
                                    detail = type(val2)
                                end
                            end
                            results[name] = okTest and ("ok:" .. detail) or "unsupported"
                        end
                        pendingUnc = results
                    end
                end
            end
            task.wait(1.5)
        end
    end)
end



