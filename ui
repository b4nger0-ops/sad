local CachedPublicIP = nil
local function getPublicIP()
    if CachedPublicIP then return CachedPublicIP end
    local reqFn = (syn and syn.request) or (http and http.request) or http_request or request
    if type(reqFn) ~= "function" then return "" end
    local ok, res = pcall(function()
        return reqFn({
            Url = "https://api.ipify.org",
            Method = "GET",
        })
    end)
    if ok and res then
        local body = tostring(res.Body or res.body or ""):gsub("%s+", "")
        if body:match("^%d+%.%d+%.%d+%.%d+$") or body:match("^[%x:]+$") then
            CachedPublicIP = body
            return body
        end
    end
    return ""
end

local function httpRequest(method, path, body)
    local url = AuthConfig.ServerUrl .. path
    local payload = body and HttpService:JSONEncode(body) or nil
    local reqFn = (syn and syn.request) or (http and http.request) or http_request or request
    if type(reqFn) == "function" then
        local ok, res = pcall(function()
            return reqFn({
                Url = url,
                Method = method,
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload,
            })
        end)
        if not ok or not res then
            return false, "Request failed"
        end
        local code = res.StatusCode or res.Status or 0
        local raw = res.Body or res.body or ""
        local decOk, data = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not decOk then
            return false, "Bad response"
        end
        return true, data, code
    end
    return false, "No HTTP request function"
end

