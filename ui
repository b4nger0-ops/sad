    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local bind = Window.UIKeybind
        local matched = false
        if typeof(bind) == "EnumItem" then
            matched = (input.KeyCode == bind)
        elseif typeof(bind) == "table" then
            
            local allDown = true
            local containsThis = false
            for _, kc in ipairs(bind) do
                if kc == input.KeyCode then containsThis = true end
                if kc ~= input.KeyCode and not UserInputService:IsKeyDown(kc) then
                    allDown = false
                end
            end
            matched = containsThis and allDown
        end
        if matched then
            if Window.Visible then
                
                local espWasOn = ESPPreviewGui and ESPPreviewGui.Enabled
                if espWasOn and ESPFrame then
                    local info = TweenInfo.new(Window.FadeTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    pcall(function()
                        TweenService:Create(ESPFrame, info, {BackgroundTransparency = 1}):Play()
                        local stroke = ESPFrame:FindFirstChildOfClass("UIStroke")
                        if stroke then TweenService:Create(stroke, info, {Transparency = 1}):Play() end
                        if ESPTitleBar then TweenService:Create(ESPTitleBar, info, {BackgroundTransparency = 1}):Play() end
                        if ESPTitle then TweenService:Create(ESPTitle, info, {TextTransparency = 1}):Play() end
                        if Viewport then TweenService:Create(Viewport, info, {BackgroundTransparency = 1}):Play() end
                        local vpStroke = Viewport and Viewport:FindFirstChildOfClass("UIStroke")
                        if vpStroke then TweenService:Create(vpStroke, info, {Transparency = 1}):Play() end
                    end)
                end
                fadeAll(1, function()
                    ScreenGui.Enabled = false
                    Window.Visible = false
                    applyUIBlur()
                    if ESPPreviewGui then ESPPreviewGui.Enabled = false end

                    pcall(function()
                        if ESPFrame then ESPFrame.BackgroundTransparency = 0 end
                        local stroke = ESPFrame and ESPFrame:FindFirstChildOfClass("UIStroke")
                        if stroke then stroke.Transparency = 0 end
                        if ESPTitleBar then ESPTitleBar.BackgroundTransparency = 0 end
                        if ESPTitle then ESPTitle.TextTransparency = 0 end
                        if Viewport then Viewport.BackgroundTransparency = 0 end
                        local vpStroke = Viewport and Viewport:FindFirstChildOfClass("UIStroke")
                        if vpStroke then vpStroke.Transparency = 0 end
                    end)
                    restoreAll()
                end)
            else
                ScreenGui.Enabled = true
                Window.Visible = true
                restoreAll()
                applyUIBlur()

                local wantEsp = Library.Toggles and Library.Toggles.ESPPreview and Library.Toggles.ESPPreview.Value == true
                if wantEsp and ESPPreviewGui then
                    ESPPreviewGui.Enabled = true
                end
            end
        end
    end)

    function Window:AddTab(name)
        self.TabCount += 1

        local tabBtn = Instance.new("TextButton")
        tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        tabBtn.BorderSizePixel = 0
        tabBtn.Size = UDim2.fromOffset(90, 22)
        tabBtn.Font = Font
        tabBtn.Text = name
        tabBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
        tabBtn.TextSize = 12
        tabBtn.Parent = self.TabBar
        local tabStroke = Instance.new("UIStroke")
        tabStroke.Color = Theme.OutlineColor
        tabStroke.Thickness = 1
        tabStroke.Parent = tabBtn

        local scroll = Instance.new("ScrollingFrame")
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.Size = UDim2.new(1, 0, 1, 0)
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.ScrollBarThickness = IsMobile and 6 or 3
        scroll.ScrollBarImageColor3 = Theme.AccentColor
        scroll.ScrollingEnabled = true
        scroll.Active = true
        scroll.ScrollingDirection = Enum.ScrollingDirection.Y
        scroll.ElasticBehavior = Enum.ElasticBehavior.Always
        scroll.ClipsDescendants = true
        pcall(function()
            scroll.ScrollBarImageTransparency = 0
        end)
        scroll.Visible = false
        scroll.Parent = self.ContentContainer

        local inner = Instance.new("Frame")
        inner.BackgroundTransparency = 1
        inner.Size = UDim2.new(1, 0, 0, 0)
        inner.Parent = scroll

        local tab = {
            Name = name, Btn = tabBtn, Content = scroll, Inner = inner,
            LeftElements = {}, RightElements = {}, LeftY = 8, RightY = 8
        }

        local function updateCanvas()
            local maxY = math.max(tab.LeftY, tab.RightY)
            inner.Size = UDim2.new(1, 0, 0, maxY + 8)
            scroll.CanvasSize = UDim2.new(0, 0, 0, maxY + 16)
        end
        tab.UpdateCanvas = updateCanvas

        local function reLayout(isLeft)
            local list = isLeft and tab.LeftElements or tab.RightElements
            local y = 8
            local totalWidth = math.max(inner.AbsoluteSize.X, ContentContainer.AbsoluteSize.X)
            local padding = 8
            local gap = 10
            local half = math.floor((totalWidth - padding * 2 - gap) / 2)
            local full = math.max(120, math.floor(totalWidth - padding * 2))
            for _, el in ipairs(list) do
                if not el.Box then continue end
                if el.Box.Visible == false then
                    continue
                end
                local target = el.Box
                local h = el.Box.Size.Y.Offset
                local colW = el.FullWidth and full or half
                if isLeft or el.FullWidth then
                    target.Position = UDim2.fromOffset(padding, y)
                    target.Size = UDim2.fromOffset(colW, h)
                else
                    target.Position = UDim2.fromOffset(padding + half + gap, y)
                    target.Size = UDim2.fromOffset(colW, h)
                end
                el.Box.Size = UDim2.fromOffset(colW, el.Box.Size.Y.Offset)
                y = y + h + 8
            end
            if isLeft then tab.LeftY = y else tab.RightY = y end
            updateCanvas()
        end

        function tab.Relayout()
            reLayout(true)
            reLayout(false)
        end

        tabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(self.Tabs) do
                t.Btn.TextColor3 = Color3.fromRGB(160, 160, 160)
