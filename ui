    local function getAnimList()
        local animate = getAnimateFolder()
        local fromSource = {}
        local seen = { live = true }
        -- Live is always first: mirrors the source character pose each frame
        table.insert(fromSource, { Name = "Live", Ids = {}, RawName = "Live" })
        if animate then
            for _, ch in ipairs(animate:GetChildren()) do
                local key = string.lower(ch.Name)
                if PREVIEW_ALLOWED_ANIMS[key] and key ~= "live" then
                    local ids = collectIdsFromAnimateNode(ch)
                    if #ids > 0 and not seen[key] then
                        seen[key] = true
                        local pretty = ch.Name:sub(1, 1):upper() .. ch.Name:sub(2)
                        table.insert(fromSource, { Name = pretty, Ids = ids, RawName = ch.Name })
                    end
                end
            end
            -- keep Live first, sort the rest
            local rest = {}
            for i = 2, #fromSource do rest[#rest+1] = fromSource[i] end
            table.sort(rest, function(a, b) return a.Name:lower() < b.Name:lower() end)
            fromSource = { fromSource[1] }
            for _, a in ipairs(rest) do table.insert(fromSource, a) end
        end
        if #fromSource > 1 then
            table.insert(fromSource, { Name = "None", Ids = {} })
            return fromSource
        end
        -- fallback defaults filtered to allowed names
        local base = (previewRigType == "R6") and ANIMS_R6 or ANIMS_R15
        local filtered = { { Name = "Live", Ids = {}, RawName = "Live" } }
        for _, a in ipairs(base) do
            if PREVIEW_ALLOWED_ANIMS[string.lower(a.Name)] or a.Name == "None" then
                table.insert(filtered, a)
            end
        end
        if #filtered <= 1 then
            local out = { { Name = "Live", Ids = {}, RawName = "Live" } }
            for _, a in ipairs(base) do table.insert(out, a) end
            return out
        end
        return filtered
    end

