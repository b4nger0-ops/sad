    local function registerKeybind(name, defaultKeyName, opts)
        opts = opts or {}
        local keyCodes = {}
        if defaultKeyName and defaultKeyName ~= "None" then
            
            for part in string.gmatch(defaultKeyName, "[^%+]+") do
                local trimmed = part:match("^%s*(.-)%s*$")
                local ok, kc = pcall(function() return Enum.KeyCode[trimmed] end)
                if ok and kc then table.insert(keyCodes, kc) end
            end
        end
        local entry = {
            Name = name,
            KeyName = formatKeyName(keyCodes),
            KeyCodes = keyCodes,
            Mode = opts.Mode or "Hold",
            Held = false,
            Toggled = opts.DefaultToggled or false,
            OnToggle = opts.OnToggle,
            OnState = opts.OnState,
        }
        if entry.KeyName == "" then entry.KeyName = "None" end
        table.insert(KeybindRegistry, entry)
        if not IsMobile then
            refreshKeybindViewer()
        end
        return entry
    end

    
