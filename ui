            local cardH = math.floor(56 * scale + 0.5)
            selectedCard.Size = UDim2.new(1, 0, 0, cardH)
            if selAvatar then
                local as = math.floor(44 * scale + 0.5)
                selAvatar.Size = UDim2.fromOffset(as, as)
                selAvatar.Position = UDim2.fromOffset(6, math.floor((cardH - as) / 2))
            end
            if selectedLabel then
                selectedLabel.TextSize = math.floor(13 * scale + 0.5)
                selectedLabel.Position = UDim2.fromOffset(6 + math.floor(44 * scale) + 8, 4)
            end
            if selectedStats then
                selectedStats.TextSize = math.floor(11 * scale + 0.5)
                selectedStats.Position = UDim2.fromOffset(6 + math.floor(44 * scale) + 8, 24)
