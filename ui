local function hideMainGui()
    pcall(function()
        local parent = (gethui and gethui()) or game:GetService("CoreGui")
        local gui = parent:FindFirstChild("DupeMenu")
        if gui then gui.Enabled = false end
        if Window and Window.ScreenGui then Window.ScreenGui.Enabled = false end
        if Window and Window.MainWindow then Window.MainWindow.Visible = false end
    end)
end

local function trySilentReconnect()
    if not (isfile and readfile) then return false end
    local ok, user = pcall(readfile, AuthConfig.SessionFile)
    if not ok or not user or tostring(user):gsub("%s+", "") == "" then
        return false
    end
    user = tostring(user):gsub("%s+$", ""):gsub("^%s+", "")
    local silentGui = false
    pcall(function()
        if isfile(AuthConfig.SilentGuiFile) then
            local flag = tostring(readfile(AuthConfig.SilentGuiFile) or ""):gsub("%s+", "")
            silentGui = (flag == "1" or flag:lower() == "true")
        end
    end)
    AuthSession.Username = user
    AuthSession.Authenticated = true
    startHeartbeat()
    if silentGui then
        task.defer(function()
            task.wait(0.35)
            hideMainGui()
        end)
    end
    return true
end

