local function Notify(text, duration)
    text = tostring(text or "")
    if text == "" then return end
    duration = tonumber(duration) or 3
    if duration < 0.1 then duration = 0.1 end

    ensureNotifyGui()

    local NOTIFY_W = 200
    local CORNER_R = 10
    local STROKE_W = 2
    local TOP_H = 3
    local TIMER_H = 2
    local PAD_X = 10
    local PAD_Y = 5

    local textBounds = TextService:GetTextSize(
        text,
        11,
        Font,
        Vector2.new(NOTIFY_W - PAD_X * 2, 1000)
    )
    local bodyH = math.max(16, textBounds.Y + PAD_Y * 2)
    
    local totalH = TOP_H + bodyH + TIMER_H + STROKE_W

    
    local toast = Instance.new("Frame")
    toast.BackgroundColor3 = Theme.MainColor
    toast.BorderSizePixel = 0
    toast.Size = UDim2.fromOffset(NOTIFY_W, totalH)
    toast.ClipsDescendants = true
    toast.Parent = NotifyContainer

    local toastCorner = Instance.new("UICorner")
    toastCorner.CornerRadius = UDim.new(0, CORNER_R)
    toastCorner.Parent = toast

    local function coverCorner(ax, ay)
        local cover = Instance.new("Frame")
        cover.BackgroundColor3 = Theme.MainColor
        cover.BorderSizePixel = 0
        cover.Size = UDim2.fromOffset(CORNER_R, CORNER_R)
        cover.AnchorPoint = Vector2.new(ax, ay)
        cover.Position = UDim2.fromScale(ax, ay)
        cover.ZIndex = 2
        cover.Parent = toast
        return cover
    end
    local coverTL = coverCorner(0, 0)
    local coverBL = coverCorner(0, 1)
    local coverBR = coverCorner(1, 1)

    
    local outlineParts = {}
    local function edge(props)
        local f = Instance.new("Frame")
        f.BackgroundColor3 = Color3.new(0, 0, 0)
        f.BorderSizePixel = 0
        f.ZIndex = 8
        for k, v in pairs(props) do f[k] = v end
        f.Parent = toast
        table.insert(outlineParts, f)
        return f
    end

    
    edge({
        Size = UDim2.new(1, 0, 0, STROKE_W),
        Position = UDim2.fromOffset(0, 0),
    })
    
    edge({
        Size = UDim2.fromOffset(STROKE_W, totalH),
        Position = UDim2.fromOffset(0, 0),
    })
    
    edge({
        Size = UDim2.new(1, 0, 0, STROKE_W),
        Position = UDim2.new(0, 0, 1, -STROKE_W),
    })
    
    edge({
        Size = UDim2.fromOffset(STROKE_W, totalH),
        Position = UDim2.new(1, -STROKE_W, 0, 0),
    })

    
    local topBar = Instance.new("Frame")
    topBar.BackgroundColor3 = Color3.new(1, 1, 1)
    topBar.BorderSizePixel = 0
    topBar.Size = UDim2.new(1, 0, 0, TOP_H)
    topBar.Position = UDim2.fromOffset(0, 0)
    topBar.ZIndex = 3
    topBar.Parent = toast

    local topGrad = Instance.new("UIGradient")
    topGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, GradientColors[1]),
        ColorSequenceKeypoint.new(0.5, GradientColors[2]),
        ColorSequenceKeypoint.new(1, GradientColors[3]),
    })
    topGrad.Parent = topBar

    
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(PAD_X, TOP_H + PAD_Y)
    label.Size = UDim2.fromOffset(NOTIFY_W - PAD_X * 2, bodyH - PAD_Y * 2)
    label.Font = Font
    label.Text = text
    label.TextColor3 = Theme.FontColor
    label.TextSize = 11
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.ZIndex = 4
    label.Parent = toast

    
    local timerTrack = Instance.new("Frame")
    timerTrack.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    timerTrack.BorderSizePixel = 0
    timerTrack.Size = UDim2.new(1, 0, 0, TIMER_H)
    timerTrack.Position = UDim2.new(0, 0, 1, -(TIMER_H + STROKE_W))
    timerTrack.ZIndex = 9
    timerTrack.Parent = toast

    local timerFill = Instance.new("Frame")
    timerFill.BackgroundColor3 = Theme.AccentColor
    timerFill.BorderSizePixel = 0
    timerFill.Size = UDim2.new(1, 0, 1, 0)
    timerFill.ZIndex = 10
    timerFill.Parent = timerTrack

    local timerGrad = Instance.new("UIGradient")
    timerGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, GradientColors[1]),
        ColorSequenceKeypoint.new(0.5, GradientColors[2]),
        ColorSequenceKeypoint.new(1, GradientColors[3]),
    })
    timerGrad.Parent = timerFill

    
    local fadeTargets = {
        toast, coverTL, coverBL, coverBR, topBar, timerTrack, timerFill,
    }
    for _, p in ipairs(outlineParts) do
        table.insert(fadeTargets, p)
    end

    for _, obj in ipairs(fadeTargets) do
        obj.BackgroundTransparency = 1
    end
    label.TextTransparency = 1

    local fadeIn = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, obj in ipairs(fadeTargets) do
        TweenService:Create(obj, fadeIn, {BackgroundTransparency = 0}):Play()
    end
    TweenService:Create(label, fadeIn, {TextTransparency = 0}):Play()

    TweenService:Create(timerFill, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 0, 1, 0),
    }):Play()

    task.delay(duration, function()
        if not toast or not toast.Parent then return end
        local fadeOut = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local t1 = TweenService:Create(toast, fadeOut, {BackgroundTransparency = 1})
        for _, obj in ipairs(fadeTargets) do
            if obj ~= toast then
                TweenService:Create(obj, fadeOut, {BackgroundTransparency = 1}):Play()
            end
        end
        TweenService:Create(label, fadeOut, {TextTransparency = 1}):Play()
        t1:Play()
        t1.Completed:Wait()
        pcall(function() toast:Destroy() end)
    end)

    return toast
end

