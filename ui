-- Global UI motion settings (toggled from Settings → Menu)
Library.UIAnim = {
    Enabled = true,
    Speed = 1,          -- 0.5 = slower, 2 = faster
    Hover = true,       -- subtle hover brighten on interactive rows
    TabTransition = true,
}

local function uiAnimInfo(duration, style, dir)
    local anim = Library.UIAnim
    if not anim or not anim.Enabled then
        return TweenInfo.new(0.001)
    end
    local spd = math.clamp(tonumber(anim.Speed) or 1, 0.25, 3)
    return TweenInfo.new(
        math.max(0.01, (duration or 0.2) / spd),
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
end

local function uiTween(obj, props, duration, style, dir)
    if not obj then return nil end
    local tw = TweenService:Create(obj, uiAnimInfo(duration, style, dir), props)
    tw:Play()
    return tw
end

-- Global UI corner radius (0 = sharp, higher = more rounded). Applied to menu + floating panels.
local UICornerRadius = 0
local UI_CORNER_MAX = 16
local function shouldApplyUICorner(obj)
    if not obj or not obj:IsA("GuiObject") then return false end
    -- Always round groupbox top accent strips (even when only 2px tall)
    if obj:GetAttribute("LibTopAccent") then
        return true
    end
    -- Edge chrome of the main window: never self-round. Parent MainWindow clips them
    -- so bottom/top corners don't stick out past the outer shell.
    local edgeSkip = {
        TitleBar = true, TabBar = true, Footer = true, FeatureSearchBar = true,
    }
    if edgeSkip[obj.Name] then
        return false
    end
    local class = obj.ClassName
    if class == "UICorner" or class == "UIStroke" or class == "UIGradient"
        or class == "UIListLayout" or class == "UIPadding" or class == "UIGridLayout"
        or class == "UITableLayout" or class == "UIPageLayout" or class == "UIAspectRatioConstraint"
        or class == "UISizeConstraint" or class == "UITextSizeConstraint" then
        return false
    end
    -- skip pure text / transparent labels
    if (obj:IsA("TextLabel") or obj:IsA("ImageLabel")) and obj.BackgroundTransparency >= 0.99 then
        return false
    end
    if obj:IsA("Frame") and obj.BackgroundTransparency >= 0.99 and not obj:FindFirstChildOfClass("UIStroke") then
        return false
    end
    -- skip ultra-thin decorative bars / lines (ESP skeleton, etc.) — not top accents
    local sz = obj.AbsoluteSize
    if sz.X > 0 and sz.Y > 0 and (sz.Y <= 3 or sz.X <= 3) then
        return false
    end
    if obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("TextBox") then
        return true
    end
    if obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("ImageLabel") or obj:IsA("CanvasGroup") then
        return obj.BackgroundTransparency < 0.99 or obj:FindFirstChildOfClass("UIStroke") ~= nil
    end
    return false
end
local function ensureLibCorner(obj, radius)
    -- UI corners disabled — always strip LibCorner instances for a sharp look
    if not obj then return end
    local c = obj:FindFirstChild("LibCorner")
    if c then pcall(function() c:Destroy() end) end
    -- also strip generic UICorners that were applied for rounding (keep full-circle ones on dots/avatars)
    for _, ch in ipairs(obj:GetChildren()) do
        if ch:IsA("UICorner") and ch.Name == "LibCorner" then
            pcall(function() ch:Destroy() end)
        end
    end
end
local function polishStroke(stroke, radius)
    if not stroke or not stroke:IsA("UIStroke") then return end
    pcall(function()
        stroke.LineJoinMode = Enum.LineJoinMode.Round
        -- Border mode keeps the stroke on the outside of the curved edge
        if Enum.ApplyStrokeMode and Enum.ApplyStrokeMode.Border then
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        end
    end)
end
local function applyCornersToTree(root, radius)
    if not root then return end
    local n = root.Name
    if n == "ss" or n == "ssViewportChams" or n == "DupeSnow" or n == "DupeCrosshair" then
        return
    end
    -- Always strip LibCorners; force sharp UI
    ensureLibCorner(root, 0)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("UICorner") and d.Name == "LibCorner" then
            pcall(function() d:Destroy() end)
        end
        if d:IsA("UIStroke") then
            polishStroke(d, 0)
        end
        -- Groupbox top gradient: full width, edge-to-edge on outer box
        if d:GetAttribute("LibTopAccent") and d:IsA("GuiObject") then
            local c = d:FindFirstChild("LibCorner")
            if c then pcall(function() c:Destroy() end) end
            d.Position = UDim2.fromOffset(0, 0)
            d.Size = UDim2.new(1, 0, 0, 2)
        end
    end
end
local function applyAllUICorners(radius)
    -- Corners permanently disabled
    radius = 0
    UICornerRadius = 0
    local roots = {}
    local function add(gui)
        if gui and gui.Parent then table.insert(roots, gui) end
    end
    local parent = (gethui and gethui()) or game:GetService("CoreGui")
    for _, name in ipairs({
        "DupeMenu", "DupeWatermark", "DupeKeybinds", "DupeESPPreview",
        "DupeNotify", "LibraryTooltip",
    }) do
        local g = parent:FindFirstChild(name) or game:GetService("CoreGui"):FindFirstChild(name)
        add(g)
    end
    for _, root in ipairs(roots) do
        applyCornersToTree(root, radius)

        -- Group outer/fill border rings:
        -- Outer frame (outline color) + UICorner = curved outline
        -- Inner fill (groupbox color) inset on top = hides the middle so only a
        -- curved ring of the outer color remains (UIStroke cannot curve).
        for _, d in ipairs(root:GetDescendants()) do
            if d:GetAttribute("LibGroupOuter") then
                local st = d:FindFirstChildOfClass("UIStroke")
                if radius <= 0 then
                    -- Sharp mode: use UIStroke, no corner
                    local c = d:FindFirstChild("LibCorner")
                    if c then pcall(function() c:Destroy() end) end
                    if st then st.Enabled = true; st.Transparency = 0 end
                else
                    -- Curved outline: outer frame is the visible ring
                    ensureLibCorner(d, radius)
                    if st then st.Enabled = false; st.Transparency = 1 end
                end
            end
            if d:GetAttribute("LibGroupFill") then
                local inset = 1
                if radius > 0 then
                    -- Thicker ring reads better on dark themes (2px typical)
                    inset = math.max(2, math.min(3, math.floor(radius * 0.15 + 1.5)))
                end
                d.Position = UDim2.fromOffset(inset, inset)
                d.Size = UDim2.new(1, -inset * 2, 1, -inset * 2)
                if radius <= 0 then
                    local c = d:FindFirstChild("LibCorner")
                    if c then pcall(function() c:Destroy() end) end
                    d.ClipsDescendants = false
                else
                    -- Fill corner slightly smaller so the outer ring thickness is even
                    ensureLibCorner(d, math.max(0, radius - inset))
                    d.ClipsDescendants = true
                end
            end
            if d:GetAttribute("LibTopAccent") and d:IsA("GuiObject") then
                local c = d:FindFirstChild("LibCorner")
                if c then pcall(function() c:Destroy() end) end
                -- Always full width edge-to-edge on the outer groupbox
                d.Position = UDim2.fromOffset(0, 0)
                d.Size = UDim2.new(1, 0, 0, 2)
            end
        end

        if root.Name == "DupeMenu" then
            local mw = root:FindFirstChild("MainWindow")
            local border = root:FindFirstChild("MainWindowBorder")
            if mw then
                ensureLibCorner(mw, radius)
                -- TitleBar / Footer must NOT get independent UICorners — that causes
                -- square bottoms/tops to stick out past the main rounded shell.
                -- Parent ClipsDescendants + main window corner clips them cleanly.
                for _, childName in ipairs({ "TitleBar", "TabBar", "Header", "Footer", "ContentContainer", "FeatureSearchBar" }) do
                    local ch = mw:FindFirstChild(childName)
                    if ch then
                        local existing = ch:FindFirstChild("LibCorner")
                        if existing then pcall(function() existing:Destroy() end) end
                        -- Keep these flush; only MainWindow is rounded
                    end
                end
                -- Soft-round only inner panels that sit away from the outer edge
                for _, childName in ipairs({ "Header", "ContentContainer" }) do
                    local ch = mw:FindFirstChild(childName)
                    if ch and radius > 0 then
                        ensureLibCorner(ch, math.max(0, math.min(6, radius - 2)))
                    end
                end
                mw.ClipsDescendants = radius > 0
                -- Sync curved outer border ring (replaces UIStroke when radius > 0)
                if type(syncMainWindowBorder) == "function" then
                    pcall(syncMainWindowBorder)
                elseif border then
                    local t = 2
                    if radius <= 0 then
                        border.Visible = false
                        local ws = mw:FindFirstChildOfClass("UIStroke")
                        if ws then ws.Enabled = true; ws.Transparency = 0 end
                        mw.ClipsDescendants = false
                    else
                        local ws = mw:FindFirstChildOfClass("UIStroke")
                        if ws then ws.Enabled = false; ws.Transparency = 1 end
                        mw.ClipsDescendants = true
                        border.Visible = true
                        border.AnchorPoint = Vector2.new(0, 0)
                        local asz = mw.AbsoluteSize
                        local parentAbs = root.AbsolutePosition
                        local mwAbs = mw.AbsolutePosition
                        border.Position = UDim2.fromOffset(mwAbs.X - parentAbs.X - t, mwAbs.Y - parentAbs.Y - t)
                        border.Size = UDim2.fromOffset(asz.X + t * 2, asz.Y + t * 2)
                        ensureLibCorner(border, radius + t)
                    end
                end
            end
        end
    end
end


