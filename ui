        return matches
    end

    local function layoutSearchResults(groups, animate)
        if not SearchInner or not SearchHost then return end
        local totalWidth = math.max(SearchInner.AbsoluteSize.X, (ContentContainer and ContentContainer.AbsoluteSize.X) or 300)
        local padding = 8
        local gap = 10
        local half = math.floor((totalWidth - padding * 2 - gap) / 2)
        local leftY, rightY = 8, 8
        local info = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        for _, g in ipairs(groups) do
            local box = g.Box
            if not box then continue end
            box.Visible = true
            box.BackgroundTransparency = 0
            local isLeft = g.IsLeft ~= false
            local x = isLeft and padding or (padding + half + gap)
            local y = isLeft and leftY or rightY
            local h = box.Size.Y.Offset
            if h < 10 then h = box.AbsoluteSize.Y end
            if h < 10 then h = 36 end
            box.Size = UDim2.fromOffset(half, h)
            local target = UDim2.fromOffset(x, y)
            if animate then
                TweenService:Create(box, info, { Position = target }):Play()
            else
                box.Position = target
            end
            if isLeft then
                leftY = leftY + h + 8
            else
                rightY = rightY + h + 8
            end
        end
        local maxY = math.max(leftY, rightY)
        SearchInner.Size = UDim2.new(1, 0, 0, maxY + 8)
        SearchHost.CanvasSize = UDim2.new(0, 0, 0, maxY + 16)
    end

    local function exitSearchMode()
        if not searchActive then return end
        searchActive = false
        -- Restore every reparented groupbox to its original tab inner
        for g, meta in pairs(searchReparented) do
            if g.Box and meta and meta.parent then
                g.Box.Parent = meta.parent
                g.Box.Visible = true
                g.Box.BackgroundTransparency = 0
            end
            searchReparented[g] = nil
        end
        if SearchHost then SearchHost.Visible = false end
        -- Show current tab again
        if Window and Window.Tabs then
            for _, t in pairs(Window.Tabs) do
                if t.Content then
                    t.Content.Visible = (Window.CurrentTab == t)
                end
                if t.Relayout then pcall(t.Relayout) end
            end
        end
    end

    local function enterSearchMode(query)
        if not SearchHost or not SearchInner then return end
        local matches = collectMatchingGroups(query)
        searchActive = true
        SearchHost.Visible = true

        -- Hide all tab pages while searching
        if Window and Window.Tabs then
            for _, t in pairs(Window.Tabs) do
                if t.Content then t.Content.Visible = false end
            end
        end

        -- Build set of groups that should be in the search host
        local want = {}
        for _, g in ipairs(matches) do want[g] = true end

        -- Restore groups no longer matching
        for g, meta in pairs(searchReparented) do
            if not want[g] then
                if g.Box and meta.parent then
                    g.Box.Parent = meta.parent
                    g.Box.Visible = true
                end
                searchReparented[g] = nil
            end
        end

        -- Reparent matching groups (keep left/right via IsLeft)
        for _, g in ipairs(matches) do
            if g.Box then
                if not searchReparented[g] then
                    searchReparented[g] = {
                        parent = g.Box.Parent,
                        tab = g._tab,
                    }
                end
                g.Box.Parent = SearchInner
                g.Box.Visible = true
                g.Box.BackgroundTransparency = 0
            end
        end

        layoutSearchResults(matches, true)
    end

