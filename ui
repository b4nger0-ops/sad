        makeGrip("Left", { Size = UDim2.new(0, EDGE, 1, 0), Position = UDim2.fromOffset(0, 0) })
        makeGrip("Right", { Size = UDim2.new(0, EDGE, 1, 0), Position = UDim2.new(1, -EDGE, 0, 0) })

        local function hitEdge(rel, sz)
            local onL = rel.X <= EDGE + 2
            local onR = rel.X >= sz.X - EDGE - 2
            local onT = rel.Y <= EDGE + 2
            local onB = rel.Y >= sz.Y - EDGE - 2
            if onT and onL then return "TL" end
            if onT and onR then return "TR" end
            if onB and onL then return "BL" end
            if onB and onR then return "BR" end
            if onT then return "T" end
            if onB then return "B" end
            if onL then return "L" end
            if onR then return "R" end
            return nil
        end

        local function updateHover()
            if PreviewLocked or resizing then
                if not resizing then showResizeCursor(false) end
                return
            end
            if not ESPPreviewGui or not ESPPreviewGui.Enabled then
                showResizeCursor(false)
                return
            end
            local m = UserInputService:GetMouseLocation()
            local a, s = ESPFrame.AbsolutePosition, ESPFrame.AbsoluteSize
            local rel = Vector2.new(m.X - a.X, m.Y - a.Y)
            if rel.X < -4 or rel.Y < -4 or rel.X > s.X + 4 or rel.Y > s.Y + 4 then
                hoverMode = nil
                showResizeCursor(false)
                return
            end
            hoverMode = hitEdge(rel, s)
            showResizeCursor(hoverMode ~= nil)
        end

        RunService.RenderStepped:Connect(function()
            if ESPFrame.Parent then updateHover() end
        end)

        ESPFrame.InputBegan:Connect(function(i)
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if PreviewLocked then return end
            local mouse = inputXY(i)
            local absPos = ESPFrame.AbsolutePosition
            local sz = ESPFrame.AbsoluteSize
            local rel = mouse - absPos
            local mode = hitEdge(rel, sz)
            if not mode then return end
            -- lock to top-left anchor immediately so size changes don't shift the frame upward
            ESPFrame.AnchorPoint = Vector2.new(0, 0)
            ESPFrame.Position = UDim2.fromOffset(absPos.X, absPos.Y)
            ESPFrame.Size = UDim2.fromOffset(sz.X, sz.Y)
            resizing = true
            resizeMode = mode
            resizeStart = mouse
            sizeStart = sz
            posStart = absPos
            espUserDragged = true
            showResizeCursor(true)
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
