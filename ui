    local SpectateState = {
        Active = false,
        Target = nil,
        Conns = {},
        OrigType = nil,
        OrigSubject = nil,
        Yaw = 0,
        Pitch = 0.25,
        Distance = 12,
        Sensitivity = 0.0055,
        MinDist = 3,
        MaxDist = 50,
    }

    local function setSpectateBtnText(active)
        if spectateBtn then
            spectateBtn.Text = active and "Unspectate" or "Spectate"
        end
    end

    local function stopSpectate()
        if not SpectateState.Active and #SpectateState.Conns == 0 then
            setSpectateBtnText(false)
            return
        end
        SpectateState.Active = false
        SpectateState.Target = nil
        for _, c in ipairs(SpectateState.Conns) do
            pcall(function() c:Disconnect() end)
        end
        SpectateState.Conns = {}
        local cam = workspace.CurrentCamera
        if cam then
            if SpectateState.OrigType then
                cam.CameraType = SpectateState.OrigType
            else
                cam.CameraType = Enum.CameraType.Custom
            end
            if SpectateState.OrigSubject then
                cam.CameraSubject = SpectateState.OrigSubject
            else
                local lp = Players.LocalPlayer
                local hum = lp and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum then cam.CameraSubject = hum end
            end
        end
        SpectateState.OrigType = nil
        SpectateState.OrigSubject = nil
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
        setSpectateBtnText(false)
    end

    local function startSpectate(plr)
        if not plr then
            return
        end
        local char = plr.Character
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        if not root then
            return
        end

        stopSpectate()

        local cam = workspace.CurrentCamera
        if not cam then return end

        SpectateState.OrigType = cam.CameraType
        SpectateState.OrigSubject = cam.CameraSubject
        SpectateState.Target = plr
        SpectateState.Active = true
        SpectateState.Distance = 12

        
        local toCam = cam.CFrame.Position - root.Position
        if toCam.Magnitude > 0.1 then
            SpectateState.Yaw = math.atan2(-toCam.X, -toCam.Z)
            local flat = Vector3.new(toCam.X, 0, toCam.Z).Magnitude
            SpectateState.Pitch = math.atan2(toCam.Y, math.max(flat, 0.01))
        else
            SpectateState.Yaw = 0
            SpectateState.Pitch = 0.25
        end
        SpectateState.Pitch = math.clamp(SpectateState.Pitch, -1.45, 1.45)

        cam.CameraType = Enum.CameraType.Scriptable
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        end)

        
        -- Escape intentionally does NOT stop spectate; only Unspectate button does
        table.insert(SpectateState.Conns, UserInputService.InputBegan:Connect(function(inp)
            if not SpectateState.Active then return end
        end))
        table.insert(SpectateState.Conns, UserInputService.InputChanged:Connect(function(inp)
            if not SpectateState.Active then return end
            if inp.UserInputType == Enum.UserInputType.MouseMovement then
                
                SpectateState.Yaw = SpectateState.Yaw - inp.Delta.X * SpectateState.Sensitivity
                SpectateState.Pitch = math.clamp(
                    SpectateState.Pitch - inp.Delta.Y * SpectateState.Sensitivity,
                    -1.45, 1.45
                )
            elseif inp.UserInputType == Enum.UserInputType.MouseWheel then
                SpectateState.Distance = math.clamp(
                    SpectateState.Distance - inp.Position.Z * 2.5,
                    SpectateState.MinDist,
                    SpectateState.MaxDist
                )
            end
        end))
        table.insert(SpectateState.Conns, RunService.RenderStepped:Connect(function()
            if not SpectateState.Active then return end
            local target = SpectateState.Target
            if not target or not target.Parent then
                stopSpectate()
                return
            end
            local c = target.Character
            local r = c and (c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart)
            if not r then return end

            local focus = r.Position + Vector3.new(0, 1.5, 0)
            
            local rot = CFrame.Angles(0, SpectateState.Yaw, 0) * CFrame.Angles(SpectateState.Pitch, 0, 0)
            local camPos = (CFrame.new(focus) * rot * CFrame.new(0, 0, SpectateState.Distance)).Position
            cam.CFrame = CFrame.lookAt(camPos, focus)
            cam.Focus = CFrame.new(focus)

            
            if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter end)
            end
        end))

        setSpectateBtnText(true)
    end

    spectateBtn.MouseButton1Click:Connect(function()
        if SpectateState.Active then
