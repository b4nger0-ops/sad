            pcall(function() table.insert(parents, CoreGui) end)
            local names = {
                "DupeMenu", "DupeWatermark", "DupeKeybinds", "DupeESPPreview",
                "DupeCrosshair", "ss", "LibraryTooltip", "DupeSnow", "DupeResizeCursor", "DupeUIBlur",
                            }
