            ring.Color = Color3.fromRGB(255, 255, 255)
            ring.Thickness = 1
            ring.Transparency = 0.4
            ring.Parent = d
            table.insert(SnapDots, d)
        end
    end

    local function vAlignToT(vAlign)
        if vAlign == "Top" then return 0
        elseif vAlign == "Quarter" then return 0.25
        elseif vAlign == "Half" then return 0.5
        elseif vAlign == "ThreeQuarters" then return 0.75
        else return 1 end 
    end

    local function alignToT(align)
        if align == "Left" then return 0
        elseif align == "Right" then return 1
        else return 0.5 end
    end

    
    
    local function layoutToPos(layout, box, textW, textH, stackIndex)
        stackIndex = stackIndex or 0
        local leftX, topY, boxW, boxH, cx, bottomY = box.leftX, box.topY, box.boxW, box.boxH, box.cx, box.bottomY
        local side = layout.side or "Top"
        local pad = 6
        local x, y
        textW = textW or 0
        textH = textH or 16

        if side == "Top" then
            local align = layout.align or "Middle"
            local t = alignToT(align)
            x = leftX + boxW * t
            y = topY - pad - textH * 0.5 - stackIndex * (textH + 2)
            if align == "Left" then
                return x, y, Vector2.new(0, 0.5)
            elseif align == "Right" then
                return x, y, Vector2.new(1, 0.5)
            end
            return x, y, Vector2.new(0.5, 0.5)
        elseif side == "Bottom" then
            local align = layout.align or "Middle"
            local t = alignToT(align)
            x = leftX + boxW * t
            y = bottomY + pad + textH * 0.5 + stackIndex * (textH + 2)
            if align == "Left" then
                return x, y, Vector2.new(0, 0.5)
            elseif align == "Right" then
                return x, y, Vector2.new(1, 0.5)
            end
            return x, y, Vector2.new(0.5, 0.5)
        elseif side == "Left" then
            
            local t = vAlignToT(layout.vAlign)
            x = leftX - pad
            y = topY + boxH * t
            return x, y, Vector2.new(1, 0.5)
        else 
            
            local t = vAlignToT(layout.vAlign)
            x = leftX + boxW + pad
            y = topY + boxH * t
            return x, y, Vector2.new(0, 0.5)
        end
    end

    local function getBoxMetrics()
        
        
        
        local vp = ESPOverlay.AbsoluteSize
        if vp.X < 1 or vp.Y < 1 then
            vp = Viewport.AbsoluteSize
        end
        if vp.X < 1 or vp.Y < 1 then
            vp = Vector2.new(148, 240)
        end

        local leftX, topY, rightX, bottomY
        local okProj = false

        local root = dummy and (dummy:FindFirstChild("HumanoidRootPart") or dummy.PrimaryPart)
        if root and Cam then
            local camVp = Cam.ViewportSize
            if camVp.X < 1 or camVp.Y < 1 then
                camVp = Vector2.new(vp.X, vp.Y)
            end
            local scaleX = vp.X / camVp.X
            local scaleY = vp.Y / camVp.Y

            local origin = root.Position
            
            local halfH = (uprightHeightStuds or 5) * 0.5
            local topWorld = origin + Vector3.new(0, halfH, 0)
            local botWorld = origin - Vector3.new(0, halfH, 0)
            local spTop = Cam:WorldToViewportPoint(topWorld)
            local spBot = Cam:WorldToViewportPoint(botWorld)
            local spMid = Cam:WorldToViewportPoint(origin)

            if spMid.Z > 0 and spTop.Z > 0 and spBot.Z > 0 then
                local midX = spMid.X * scaleX
                local topYpx = spTop.Y * scaleY
                local botYpx = spBot.Y * scaleY
                local boxH = math.abs(botYpx - topYpx)
                
                local aspect = (uprightWidthStuds or 2) / math.max(uprightHeightStuds or 5, 0.1)
                local boxW = boxH * math.clamp(aspect, 0.42, 0.75)
                boxH = boxH * 1.06
                boxW = boxW * 1.08
                if boxH >= vp.Y * 0.12 and boxH <= vp.Y * 1.2 and boxW >= 4 then
                    okProj = true
                    local midY = (math.min(topYpx, botYpx) + math.max(topYpx, botYpx)) * 0.5
                    leftX = midX - boxW * 0.5
                    rightX = midX + boxW * 0.5
                    topY = midY - boxH * 0.5
                    bottomY = midY + boxH * 0.5
                end
            end
        end

        if not okProj then
            
            local zoom = math.clamp(PreviewZoom or 1, PREVIEW_ZOOM_MIN, PREVIEW_ZOOM_MAX)
            local boxW = (vp.X * 0.50) * zoom
            local boxH = (vp.Y * 0.62) * zoom
            boxW = math.clamp(boxW, vp.X * 0.22, vp.X * 0.90)
            boxH = math.clamp(boxH, vp.Y * 0.28, vp.Y * 0.88)
            local cx = vp.X * 0.5
            local cy = vp.Y * 0.48
            topY = cy - boxH * 0.5
            bottomY = topY + boxH
            leftX = cx - boxW * 0.5
            rightX = leftX + boxW
        end

        local boxW = math.max(4, rightX - leftX)
        local boxH = math.max(4, bottomY - topY)
        local cx = (leftX + rightX) * 0.5
        return {
            vp = vp, boxW = boxW, boxH = boxH, cx = cx,
            topY = topY, bottomY = bottomY, leftX = leftX,
        }
    end

    local function buildSnapPoints(box)
        local pts = {}
        local leftX, topY, boxW, boxH, bottomY = box.leftX, box.topY, box.boxW, box.boxH, box.bottomY
        local aligns = { "Left", "Middle", "Right" }
        local vAligns = { "Top", "Quarter", "Half", "ThreeQuarters", "Full" }
        for _, a in ipairs(aligns) do
            local t = alignToT(a)
            table.insert(pts, { side = "Top", align = a, vAlign = "Top", x = leftX + boxW * t, y = topY })
            table.insert(pts, { side = "Bottom", align = a, vAlign = "Full", x = leftX + boxW * t, y = bottomY })
        end
        for _, va in ipairs(vAligns) do
            local t = vAlignToT(va)
            table.insert(pts, { side = "Left", align = "Middle", vAlign = va, x = leftX, y = topY + boxH * t })
            table.insert(pts, { side = "Right", align = "Middle", vAlign = va, x = leftX + boxW, y = topY + boxH * t })
        end
        return pts
    end

    local function showSnapDots(visible, highlightIdx)
        ensureSnapDots()
        local box = getBoxMetrics()
        if box.vp.X < 1 then return end
        local pts = buildSnapPoints(box)
        for i, d in ipairs(SnapDots) do
            local p = pts[i]
            if p and visible then
                d.Position = UDim2.fromOffset(p.x, p.y)
                d.Visible = true
                if highlightIdx == i then
                    d.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    d.BackgroundTransparency = 0
                    d.Size = UDim2.fromOffset(SNAP_DOT_SIZE + 3, SNAP_DOT_SIZE + 3)
                else
                    d.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
                    d.BackgroundTransparency = 0.4
                    d.Size = UDim2.fromOffset(SNAP_DOT_SIZE, SNAP_DOT_SIZE)
                end
            else
                d.Visible = false
            end
        end
    end

    -- alwaysSnap: when true (on drop), return the closest point even if far away
    local function nearestSnap(mx, my, alwaysSnap)
        local box = getBoxMetrics()
        local pts = buildSnapPoints(box)
        local best, bestDist = nil, math.huge
        local bestIdx = nil
        for i, p in ipairs(pts) do
            local dx, dy = p.x - mx, p.y - my
            local dist = dx * dx + dy * dy
            if dist < bestDist then
                bestDist = dist
                best = p
                bestIdx = i
            end
        end
        if alwaysSnap then
            return best, bestIdx
        end
        -- While dragging: magnetic only within ~56px so the label can free-follow the mouse
        if best and bestDist <= (56 * 56) then
            return best, bestIdx
        end
        return nil, nil
    end

    
