    local function applyRowContent(entry, plr)
        if not entry or not plr then return end
        local tag = statusTag(plr)
        local col = statusColor(plr)
        local selected = (PlayerListState.SelectedUserId == plr.UserId)
        -- KD / cheater checks removed
        if entry.line1 then
            entry.line1.RichText = false
            entry.line1.Text = plr.Name .. tag
            entry.line1.TextColor3 = selected and Color3.fromRGB(235, 235, 235) or col
        end
        if entry.line2 then
            local ageDays = tonumber(plr.AccountAge) or 0
            local ageStr
            if ageDays >= 365 then
                ageStr = string.format("%.1fy", ageDays / 365)
            else
                ageStr = string.format("%dd", ageDays)
            end
            entry.line2.Text = string.format("@%s  Age:%s",
                plr.DisplayName,
                ageStr)
            entry.line2.TextColor3 = selected and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(150, 150, 150)
        end
        if entry.btn then
            entry.btn.BackgroundColor3 = selected and selectionFillColor() or Color3.fromRGB(28, 28, 28)
            local stroke = entry.btn:FindFirstChildOfClass("UIStroke")
            if stroke then
                if selected then
                    stroke.Color = Theme.UtilityColor or Theme.AccentColor or GradientColors[1]
                    stroke.Thickness = 1.5
                else
                    stroke.Color = Theme.OutlineColor
                    stroke.Thickness = 1
                end
            end
            -- soft utility / title gradient wash when selected
            local grad = entry.btn:FindFirstChild("SelectGrad")
            if selected then
                if not grad then
                    grad = Instance.new("UIGradient")
                    grad.Name = "SelectGrad"
                    grad.Parent = entry.btn
                end
                local c1 = GradientColors[1] or Theme.AccentColor
                local c2 = GradientColors[2] or Theme.UtilityColor or c1
                local c3 = GradientColors[3] or c1
                -- darken so it is not neon-bright
                local function dim(c, f)
                    return Color3.new(c.R * f + 0.05, c.G * f + 0.05, c.B * f + 0.05)
                end
                grad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, dim(c1, 0.45)),
                    ColorSequenceKeypoint.new(0.5, dim(c2, 0.4)),
                    ColorSequenceKeypoint.new(1, dim(c3, 0.45)),
                })
                grad.Enabled = true
                entry.btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            elseif grad then
                grad.Enabled = false
            end
        end
    end

