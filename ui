            if isToggle then
                if state then
                    btn.BackgroundColor3 = Theme.AccentColor
                    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    stroke.Color = Theme.AccentColor
                else
                    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
