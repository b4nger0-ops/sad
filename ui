    local function nearestBarSnap(lx, ly)
        local box = getBoxMetrics()
        local pts = buildSnapPoints(box)
        local best, bestDist, bestIdx = nil, math.huge, nil
        for i, p in ipairs(pts) do
            if p.side == "Left" or p.side == "Right" then
                local dx, dy = p.x - lx, p.y - ly
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = p
                    bestIdx = i
                end
            end
        end
        return best, bestIdx
    end

    UserInputService.InputChanged:Connect(function(inp)
        if not DragState.active then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local lx, ly = getOverlayMouse()

        -- Always resolve the final snap target (for ghost + highlighted dot)
        local snap, idx
        if DragState.isBar then
            snap, idx = nearestBarSnap(lx, ly)
        else
            snap, idx = nearestSnap(lx, ly, true)
        end
        showSnapDots(true, idx)

        if DragState.isBar then
            local hw = 3
            local box = getBoxMetrics()
            -- Real bar free-follows mouse X (clamped near the box)
            local barX = math.clamp(lx, box.leftX - 24, box.leftX + box.boxW + 24)
            local fillH = box.boxH * math.clamp(ESPState.HealthPct, 0, 1)
            HealthOutline.Position = UDim2.fromOffset(barX - 1, box.topY - 1)
            HealthOutline.Size = UDim2.fromOffset(hw + 2, box.boxH + 2)
            HealthBack.Position = UDim2.fromOffset(barX, box.topY)
            HealthBack.Size = UDim2.fromOffset(hw, box.boxH)
            HealthBar.Position = UDim2.fromOffset(barX, box.topY + box.boxH - fillH)
