---------------------------------------------------------------------------
local ViewportChams = {
    Gui = nil,
    Frame = nil,
    World = nil,
    Cam = nil,
    Entries = {}, -- [Player] = entry
    Conn = nil,
    CharConns = {}, -- [Player] = {RBXScriptConnection...}
    MaxDist = 500,
    RebuildCooldown = 3.0,
}

local function vcDisconnectPlayer(plr)
    local list = ViewportChams.CharConns[plr]
    if list then
        for _, c in ipairs(list) do
            pcall(function() c:Disconnect() end)
        end
        ViewportChams.CharConns[plr] = nil
    end
end

local function vcDestroyEntry(plr)
    local e = ViewportChams.Entries[plr]
    if e then
        if e.model then
            pcall(function() e.model:Destroy() end)
        end
        -- drop strong refs so instances can GC
        if e.pairs then
            for i = #e.pairs, 1, -1 do e.pairs[i] = nil end
        end
        ViewportChams.Entries[plr] = nil
    end
end

local function vcEnsureGui()
