    local function collectMatchingGroups(query)
        local seen = {}
        local matches = {}
        for _, feat in ipairs(FeatureRegistry) do
            local g = feat.group
            if g and g.Box and not seen[g] then
                if feat.name and feat.name:lower():find(query, 1, true) then
                    seen[g] = true
                    table.insert(matches, g)
                end
            end
