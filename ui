-- Always animate highlight chams fill through the 3 gradient colors (no toggle)
ChamsGradientWaveEnabled = true
task.spawn(function()
    local function lerpColor(a, b, t)
        t = math.clamp(t, 0, 1)
        return Color3.new(
            a.R + (b.R - a.R) * t,
            a.G + (b.G - a.G) * t,
            a.B + (b.B - a.B) * t
        )
    end
    local last = tick()
    while true do
        if Toggles.HighlightChams then
            local now = tick()
            local dt = math.clamp(now - last, 0, 0.1)
            last = now
            ChamsGradientWaveT = (ChamsGradientWaveT + dt * 1.25) % 3
            local seg = math.floor(ChamsGradientWaveT)
            local f = ChamsGradientWaveT - seg
            f = f * f * (3 - 2 * f)
            local c1 = ESPColors.ChamsGrad1
            local c2 = ESPColors.ChamsGrad2
            local c3 = ESPColors.ChamsGrad3
            local col
            if seg == 0 then col = lerpColor(c1, c2, f)
            elseif seg == 1 then col = lerpColor(c2, c3, f)
            else col = lerpColor(c3, c1, f)
            end
            ESPColors.ChamsFill = col
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hl = p.Character:FindFirstChild("ThermalHighlight")
                    if hl then
                        hl.FillColor = col
                        hl.OutlineTransparency = 1
                    end
                end
            end
            if Window and Window.ESPPreview and Window.ESPPreview.SetChamsColors then
                pcall(function() Window.ESPPreview:SetChamsColors(col, nil) end)
            end
            task.wait(0.033)
        else
            last = tick()
            task.wait(0.15)
        end
    end
end)

