        -- Keep the current dummy (or the first model if dummy missing)
        local keep = dummy
        if not keep or not keep.Parent then
            keep = models[1]
        end
        for _, m in ipairs(models) do
            if m ~= keep then
                pcall(function() m:Destroy() end)
            end
        end
        if keep and keep.Parent then
            pcall(function() stripPreviewGear(keep) end)
            -- Dedupe body part names again
            local seen = {}
            local kill = {}
            for _, d in ipairs(keep:GetDescendants()) do
                if d:IsA("BasePart") and BODY_PART_NAMES[d.Name] then
                    if seen[d.Name] then
                        table.insert(kill, d)
                    else
                        seen[d.Name] = true
                    end
                end
            end
            for _, o in ipairs(kill) do
                pcall(function() o:Destroy() end)
            end
        end
    end
