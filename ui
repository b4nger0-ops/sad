function Library:CreateWindow(opts)
    opts = opts or {}
    local baseTitle = opts.Title or "Secret Services"
    local fadeTime  = opts.MenuFadeTime or 0.2

    local function getHui()
        return (gethui and gethui()) or CoreGui
    end
    -- InputObject.Position is Vector3 on modern clients; GUI Absolute* is Vector2
    local function inputXY(inp)
        local p = inp.Position
        return Vector2.new(p.X, p.Y)
    end
    local MainWindow -- forward decl (used by blur / resize before construction)
    local Window -- forward decl

    -- If a previous instance is still alive, fully unload it first (toggles off → hooks → destroy)
    -- so re-executing the script does not leave ESP / blur / overlays half-alive.
    do
        local prev = nil
        if getgenv then
            pcall(function() prev = getgenv().SecretServicesWindow end)
        end
        if prev and type(prev) == "table" and type(prev.Close) == "function" and not prev.Closed then
            pcall(function() prev:Close() end)
            -- Brief yield so unload hooks / fade can tear down GUIs before we rebuild
            task.wait(0.15)
        end
        -- Hard cleanup of leftover ScreenGuis in case Close was skipped or incomplete
        local parents = {}
        pcall(function() table.insert(parents, getHui()) end)
        pcall(function() table.insert(parents, CoreGui) end)
        local names = {
            "DupeMenu", "DupeWatermark", "DupeKeybinds", "DupeESPPreview",
            "DupeCrosshair", "ss", "ssViewportChams", "DupeSnow", "DupeResizeCursor",
            "LibraryTooltip",
        }
        for _, parent in ipairs(parents) do
            if parent then
                for _, name in ipairs(names) do
                    local g = parent:FindFirstChild(name)
                    if g then pcall(function() g:Destroy() end) end
                end
            end
        end
        pcall(function()
            local Lighting = game:GetService("Lighting")
            local b = Lighting:FindFirstChild("DupeUIBlur")
            if b then b:Destroy() end
        end)
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DupeMenu"
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    ScreenGui.DisplayOrder = 100
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent = getHui()

    
    
    

    ---------------------------------------------------------------------------
    -- UI Blur (Lighting.BlurEffect) + Snow overlay
    ---------------------------------------------------------------------------
    local Lighting = game:GetService("Lighting")
    local UIBlurEnabled = true
    local UIBlurAmount = 24
    local BlurEffectInst = Lighting:FindFirstChild("DupeUIBlur")
    if BlurEffectInst then pcall(function() BlurEffectInst:Destroy() end) end
    BlurEffectInst = Instance.new("BlurEffect")
    BlurEffectInst.Name = "DupeUIBlur"
    BlurEffectInst.Size = 0
    BlurEffectInst.Enabled = true
    BlurEffectInst.Parent = Lighting

    local function applyUIBlur()
        local menuOpen = ScreenGui and ScreenGui.Enabled and MainWindow and MainWindow.Visible and not (Window and Window.Closed)
        if UIBlurEnabled and menuOpen then
            BlurEffectInst.Size = math.clamp(UIBlurAmount, 1, 75)
            BlurEffectInst.Enabled = true
        else
            BlurEffectInst.Size = 0
            BlurEffectInst.Enabled = false
        end
        -- Keep snow gated the same way: only when menu is open AND toggle is on
        if SnowGui then
            local wantSnow = SnowEnabled and menuOpen
            if SnowGui.Enabled ~= wantSnow then
                SnowGui.Enabled = wantSnow
                if not wantSnow then clearSnow() end
            end
        end
    end

    -- Snow effect
    local SnowGui = Instance.new("ScreenGui")
    SnowGui.Name = "DupeSnow"
    SnowGui.IgnoreGuiInset = true
    SnowGui.ResetOnSpawn = false
    SnowGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    SnowGui.DisplayOrder = 50
    SnowGui.Enabled = false
    SnowGui.Parent = getHui()
    local SnowLayer = Instance.new("Frame")
    SnowLayer.BackgroundTransparency = 1
    SnowLayer.Size = UDim2.fromScale(1, 1)
    SnowLayer.Parent = SnowGui
    local SnowEnabled = false
    local SnowAmountLevel = "Medium" -- Low / Medium / High
    local SnowSpeed = 50 -- 1-100 (higher = faster fall)
    local snowFlakes = {}
    local function clearSnow()
        for _, f in ipairs(snowFlakes) do
            pcall(function() f:Destroy() end)
        end
        for i = #snowFlakes, 1, -1 do
            snowFlakes[i] = nil
        end
    end
    local function snowSpawnCounts()
        if SnowAmountLevel == "Low" then return 1, 0.28
        elseif SnowAmountLevel == "High" then return 5, 0.07
        end
        return 2, 0.14 -- Medium
    end
    local function spawnSnowflake()
        if not SnowEnabled or not SnowGui.Enabled then return end
        local flake = Instance.new("Frame")
        flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        flake.BackgroundTransparency = math.random(10, 40) / 100
        flake.BorderSizePixel = 0
        local sz = math.random(2, 5)
        flake.Size = UDim2.fromOffset(sz, sz)
        flake.Position = UDim2.new(math.random(), 0, 0, -10)
        flake.ZIndex = 1
        flake.Parent = SnowLayer
        Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)
        table.insert(snowFlakes, flake)
        -- speed 1-100: map to duration ~12s (slow) .. ~2s (fast)
        local spd = math.clamp(tonumber(SnowSpeed) or 50, 1, 100)
        local base = 12 - (spd / 100) * 10
        local duration = math.clamp(base + (math.random() - 0.5) * 1.5, 1.5, 14)
        local drift = (math.random() - 0.5) * 0.35
        local tw = TweenService:Create(flake, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            Position = UDim2.new(math.clamp(flake.Position.X.Scale + drift, -0.05, 1.05), 0, 1.05, 0),
            BackgroundTransparency = 1,
        })
        tw:Play()
        tw.Completed:Connect(function()
            pcall(function() flake:Destroy() end)
            for i = #snowFlakes, 1, -1 do
                if snowFlakes[i] == flake then table.remove(snowFlakes, i) break end
            end
        end)
    end
    task.spawn(function()
        while SnowGui.Parent do
            if SnowEnabled and SnowGui.Enabled then
                local count, waitT = snowSpawnCounts()
                for _ = 1, count do
                    spawnSnowflake()
                end
                task.wait(waitT)
            else
                task.wait(0.4)
            end
        end
    end)

    -- Resize cursor removed (invisible outline only)
    local ResizeCursorGui = nil
    local ResizeCross = nil
    local function showResizeCursor(_on) end

    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "DupeWatermark"
    WatermarkGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    WatermarkGui.DisplayOrder = 101
    WatermarkGui.IgnoreGuiInset = true
    WatermarkGui.ResetOnSpawn = false
    WatermarkGui.Enabled = false
    WatermarkGui.Parent = getHui()

    
    local espLabelDragging = false

    local function makeDraggable(frame)
        local dragging, dragStart, startPos
        frame.InputBegan:Connect(function(i)
            if IsClickInput(i) then
                if espLabelDragging then return end
                dragging = true
                dragStart = i.Position
                startPos = frame.Position
            end
        end)
        frame.InputEnded:Connect(function(i)
            if IsClickInput(i) then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and IsHoverInput(i) then
                local d = i.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    local WatermarkFrame = Instance.new("Frame")
    WatermarkFrame.Name = "Watermark"
    WatermarkFrame.BackgroundColor3 = Theme.MainColor
    WatermarkFrame.BorderSizePixel = 0
    WatermarkFrame.AnchorPoint = Vector2.new(0.5, 0)
    WatermarkFrame.Position = UDim2.new(0.5, 0, 0, 12)
    WatermarkFrame.Size = UDim2.fromOffset(180, 28)
    WatermarkFrame.Parent = WatermarkGui
    makeDraggable(WatermarkFrame)

    local WatermarkStroke = Instance.new("UIStroke")
    WatermarkStroke.Color = Theme.AccentColor
    WatermarkStroke.Thickness = 1.5
    WatermarkStroke.Parent = WatermarkFrame

    local WatermarkPad = Instance.new("UIPadding")
    WatermarkPad.PaddingLeft = UDim.new(0, 10)
    WatermarkPad.PaddingRight = UDim.new(0, 10)
    WatermarkPad.Parent = WatermarkFrame

    
    local WatermarkInner = Instance.new("Frame")
    WatermarkInner.BackgroundTransparency = 1
    WatermarkInner.Size = UDim2.new(1, 0, 1, 0)
    WatermarkInner.Parent = WatermarkFrame

    local wmLayout = Instance.new("UIListLayout")
    wmLayout.FillDirection = Enum.FillDirection.Horizontal
    wmLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    wmLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    wmLayout.Padding = UDim.new(0, 0)
    wmLayout.SortOrder = Enum.SortOrder.LayoutOrder
    wmLayout.Parent = WatermarkInner

    local function makeWmLabel(text, order)
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.AutomaticSize = Enum.AutomaticSize.X
        lbl.Size = UDim2.fromOffset(0, 28)
        lbl.Font = Font
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = order
        lbl.Parent = WatermarkInner
        return lbl
    end

    local WmLeft = makeWmLabel(baseTitle .. " | ", 1)
    local WmGame = makeWmLabel("Unknown", 2)
    WmGame.TextColor3 = Color3.fromRGB(255, 255, 0)
    local WmRight = makeWmLabel(" | UI Test", 3)

    
    local WatermarkLabel = WmLeft

    local watermarkGrad = Instance.new("UIGradient")
    watermarkGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, GradientColors[1]),
        ColorSequenceKeypoint.new(0.5, GradientColors[2]),
        ColorSequenceKeypoint.new(1, GradientColors[3]),
    })
    watermarkGrad.Parent = WmLeft

    local watermarkGradRight = Instance.new("UIGradient")
    watermarkGradRight.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, GradientColors[1]),
        ColorSequenceKeypoint.new(0.5, GradientColors[2]),
        ColorSequenceKeypoint.new(1, GradientColors[3]),
    })
    watermarkGradRight.Parent = WmRight

    local currentGameName = game.Name or "Unknown"

    local function updateWatermarkText()
        WmLeft.Text = baseTitle .. " | "
        WmGame.Text = currentGameName
        WmGame.TextColor3 = Color3.fromRGB(255, 255, 0)
        WmRight.Text = " | UI Test"
        local plain = string.format("%s | %s | UI Test", baseTitle, currentGameName)
        local bounds = TextService:GetTextSize(plain, 14, Font, Vector2.new(1000, 50))
        WatermarkFrame.Size = UDim2.fromOffset(math.clamp(bounds.X + 24, 120, 400), 28)
    end
    updateWatermarkText()

    task.spawn(function()
        local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if ok and info and info.Name then
            currentGameName = info.Name
            updateWatermarkText()
        end
    end)

    -- watermark grads driven by shared gradient Heartbeat driver

    local KeybindRegistry = {}

    local KeybindViewerGui = Instance.new("ScreenGui")
    KeybindViewerGui.Name = "DupeKeybinds"
    KeybindViewerGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    KeybindViewerGui.DisplayOrder = 102
    KeybindViewerGui.IgnoreGuiInset = true
    KeybindViewerGui.ResetOnSpawn = false
    KeybindViewerGui.Enabled = false
    KeybindViewerGui.Parent = getHui()

    local KBFrame = Instance.new("Frame")
    KBFrame.Name = "KeybindViewer"
    KBFrame.BackgroundColor3 = Theme.MainColor
    KBFrame.BorderSizePixel = 0
    KBFrame.AnchorPoint = Vector2.new(0, 0.5)
    KBFrame.Position = UDim2.new(0, 12, 0.5, 0)
    KBFrame.Size = UDim2.fromOffset(200, 40)
    KBFrame.Parent = KeybindViewerGui
    makeDraggable(KBFrame)

    local KBStroke = Instance.new("UIStroke")
    KBStroke.Color = Theme.AccentColor
    KBStroke.Thickness = 1.5
    KBStroke.Parent = KBFrame

    local KBTitle = Instance.new("TextLabel")
    KBTitle.BackgroundTransparency = 1
    KBTitle.Position = UDim2.fromOffset(8, 4)
    KBTitle.Size = UDim2.new(1, -16, 0, 16)
    KBTitle.Font = Font
    KBTitle.Text = "Keybinds"
    KBTitle.TextColor3 = Theme.FontColor
    KBTitle.TextSize = 12
    KBTitle.TextXAlignment = Enum.TextXAlignment.Left
    KBTitle.Parent = KBFrame

    local KBList = Instance.new("Frame")
    KBList.BackgroundTransparency = 1
    KBList.Position = UDim2.fromOffset(6, 22)
    KBList.Size = UDim2.new(1, -12, 1, -28)
    KBList.Parent = KBFrame

    local KBLayout = Instance.new("UIListLayout")
    KBLayout.Padding = UDim.new(0, 2)
    KBLayout.SortOrder = Enum.SortOrder.LayoutOrder
    KBLayout.Parent = KBList

    local function modeDisplayName(mode)
        if mode == "Always" then return "Always On" end
        return mode or "Hold"
    end

    local function formatKeyName(keyCodes)
        if not keyCodes or #keyCodes == 0 then return "None" end
        local parts = {}
        for _, kc in ipairs(keyCodes) do
            table.insert(parts, kc.Name)
        end
        return table.concat(parts, " + ")
    end

    local function isComboHeld(keyCodes)
        if not keyCodes or #keyCodes == 0 then return false end
        for _, kc in ipairs(keyCodes) do
            if not UserInputService:IsKeyDown(kc) then return false end
        end
        return true
    end

    local function refreshKeybindViewer()
        if IsMobile or not KeybindViewerGui or not KBList then return end
        for _, child in ipairs(KBList:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        local nameColW = 50
        for _, entry in ipairs(KeybindRegistry) do
            local nw = getTextWidth(entry.Name, 12)
            if nw > nameColW then nameColW = nw end
        end
        nameColW = math.clamp(nameColW + 4, 50, 120)

        local maxW = 140
        for i, entry in ipairs(KeybindRegistry) do
            local row = Instance.new("Frame")
            row.BackgroundTransparency = 1
            row.Size = UDim2.new(1, 0, 0, 18)
            row.LayoutOrder = i
            row.Parent = KBList

            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.BackgroundTransparency = 1
            nameLbl.Position = UDim2.fromOffset(0, 0)
            nameLbl.Size = UDim2.fromOffset(nameColW, 18)
            nameLbl.Font = Font
            nameLbl.Text = entry.Name
            nameLbl.TextColor3 = Theme.FontColor
            nameLbl.TextSize = 12
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = row

            
            local keyText = entry.KeyName or "None"
            local keyW = math.clamp(getTextWidth(keyText, 11) + 12, 28, 130)
            local keyBox = Instance.new("Frame")
            keyBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            keyBox.BorderSizePixel = 0
            keyBox.Position = UDim2.fromOffset(nameColW + 4, 1)
            keyBox.Size = UDim2.fromOffset(keyW, 16)
            keyBox.Parent = row
            Instance.new("UIStroke", keyBox).Color = Theme.OutlineColor

            local keyLbl = Instance.new("TextLabel")
            keyLbl.BackgroundTransparency = 1
            keyLbl.Size = UDim2.new(1, 0, 1, 0)
            keyLbl.Font = Font
            keyLbl.Text = keyText
            keyLbl.TextColor3 = Theme.FontColor
            keyLbl.TextSize = 11
            keyLbl.Parent = keyBox

            
            local modeLbl = Instance.new("TextLabel")
            modeLbl.BackgroundTransparency = 1
            modeLbl.Position = UDim2.fromOffset(nameColW + 4 + keyW + 6, 0)
            modeLbl.Size = UDim2.fromOffset(72, 18)
            modeLbl.Font = Font
            modeLbl.Text = modeDisplayName(entry.Mode)
            modeLbl.TextColor3 = Color3.fromRGB(120, 120, 120)
            modeLbl.TextSize = 12
            modeLbl.TextXAlignment = Enum.TextXAlignment.Left
            modeLbl.Parent = row

            local totalW = nameColW + 4 + keyW + 6 + getTextWidth(modeDisplayName(entry.Mode), 12) + 14
            if totalW > maxW then maxW = totalW end

            entry.RowFrame = row
            entry.NameLabel = nameLbl
            entry.KeyBox = keyBox
            entry.KeyLabel = keyLbl
            entry.ModeLabel = modeLbl
            entry.NameColW = nameColW
            entry.Dot = nil
        end
        local h = 26 + (#KeybindRegistry * 20)
        KBFrame.Size = UDim2.fromOffset(math.clamp(maxW, 160, 360), math.max(h, 40))
    end

    local function computeActive(entry)
        if entry.Mode == "Always" then
            return true
        elseif entry.Mode == "Hold" then
            return entry.Held == true
        elseif entry.Mode == "Toggle" then
            return entry.Toggled == true
        end
        return false
    end

    
    task.spawn(function()
        while KBFrame.Parent do
            for _, entry in ipairs(KeybindRegistry) do
                if entry.NameLabel and entry.ModeLabel then
                    local active = computeActive(entry)
                    if active then
                        entry.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        entry.ModeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        if entry.KeyLabel then entry.KeyLabel.TextColor3 = Color3.fromRGB(255, 255, 255) end
                    else
                        entry.NameLabel.TextColor3 = Theme.FontColor
                        entry.ModeLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
                        if entry.KeyLabel then entry.KeyLabel.TextColor3 = Theme.FontColor end
                    end
                    entry.ModeLabel.Text = modeDisplayName(entry.Mode)
                    if entry.KeyLabel then
                        entry.KeyLabel.Text = entry.KeyName or "None"
                        local keyW = math.clamp(getTextWidth(entry.KeyName or "None", 11) + 12, 28, 130)
                        local ncw = entry.NameColW or 70
                        if entry.KeyBox then
                            entry.KeyBox.Size = UDim2.fromOffset(keyW, 16)
                            entry.KeyBox.Position = UDim2.fromOffset(ncw + 4, 1)
                            entry.ModeLabel.Position = UDim2.fromOffset(ncw + 4 + keyW + 6, 0)
                        end
                    end
                end
            end
            task.wait(0.03)
        end
    end)

    
    local function updateHeldStates()
        for _, entry in ipairs(KeybindRegistry) do
            local wasHeld = entry.Held
            entry.Held = isComboHeld(entry.KeyCodes)
            if entry.Held and not wasHeld then
                if entry.Mode == "Toggle" then
                    entry.Toggled = not entry.Toggled
                    if entry.OnToggle then entry.OnToggle(entry.Toggled) end
                end
                if entry.OnState then entry.OnState(computeActive(entry)) end
            elseif not entry.Held and wasHeld then
                if entry.OnState then entry.OnState(computeActive(entry)) end
            end
        end
    end

    UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard then
            updateHeldStates()
