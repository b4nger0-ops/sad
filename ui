    local function nameLooksLikeGear(name)
        local n = string.lower(tostring(name or ""))
        if n == "" then return false end
        if BODY_PART_NAMES[name] then return false end
        -- never treat limb/body names as gear
        if n:find("leg", 1, true) or n:find("arm", 1, true) or n:find("hand", 1, true)
            or n:find("foot", 1, true) or n:find("torso", 1, true) or n:find("head", 1, true)
            or n:find("hip", 1, true) or n:find("root", 1, true) then
            return false
        end
        if GEAR_NAME_HINTS[n] then return true end
        for hint in pairs(GEAR_NAME_HINTS) do
            if #hint >= 4 and n:find(hint, 1, true) then
                return true
            end
        end
        return false
    end

    local function containsBodyPart(obj)
        if not obj then return false end
        if BODY_PART_NAMES[obj.Name] then return true end
        for _, d in ipairs(obj:GetDescendants()) do
            if BODY_PART_NAMES[d.Name] then return true end
            if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
                -- likely part of the rig
            end
        end
        return false
    end

    local function isLikelyGear(obj)
        if not obj then return false end
        if obj:IsA("Tool") or obj:IsA("HopperBin") then return true end
        if BODY_PART_NAMES[obj.Name] then return false end
        if containsBodyPart(obj) and not nameLooksLikeGear(obj.Name) then
            return false
        end
        if nameLooksLikeGear(obj.Name) then return true end
        if obj:IsA("Accessory") then
            local n = string.lower(tostring(obj.Name or ""))
            local handle = obj:FindFirstChild("Handle")
            local att = handle and handle:FindFirstChildOfClass("Attachment")
            local attName = att and string.lower(att.Name) or ""
            if attName:find("hair") or attName:find("face") or attName:find("hat") then
                return false
            end
            if nameLooksLikeGear(obj.Name) then return true end
            if attName:find("back") or attName:find("waist") or attName:find("bodyback") then
                return true
            end
        end
        return false
    end

    local function stripPreviewGear(model)
        if not model then return end
        local toDestroy = {}
        for _, ch in ipairs(model:GetChildren()) do
            if isLikelyGear(ch) then
                table.insert(toDestroy, ch)
            end
        end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Tool") or d:IsA("HopperBin") then
                table.insert(toDestroy, d)
            end
        end
        -- Remove duplicate rig limbs: if R15 body exists, strip classic R6 limb parts (causes double legs)
        local isR15 = model:FindFirstChild("UpperTorso") ~= nil or model:FindFirstChild("LowerTorso") ~= nil
        local isR6 = model:FindFirstChild("Torso") ~= nil and model:FindFirstChild("Left Arm") ~= nil
        local r6LimbNames = {
            ["Left Leg"] = true, ["Right Leg"] = true, ["Left Arm"] = true, ["Right Arm"] = true, Torso = true,
            ["left leg"] = true, ["right leg"] = true, ["left arm"] = true, ["right arm"] = true,
        }
        local r15LimbNames = {
            LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
            RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
            LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
            RightUpperArm = true, RightLowerArm = true, RightHand = true,
            UpperTorso = true, LowerTorso = true,
        }
        if isR15 then
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") and r6LimbNames[d.Name] then
                    table.insert(toDestroy, d)
                end
            end
            for _, ch in ipairs(model:GetChildren()) do
                if ch:IsA("BasePart") and r6LimbNames[ch.Name] then
                    table.insert(toDestroy, ch)
                end
            end
        elseif isR6 then
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") and r15LimbNames[d.Name] then
                    table.insert(toDestroy, d)
                end
            end
        end
        -- Also strip any extra nested Model that only contains limb-looking parts (common double-leg cause)
        for _, ch in ipairs(model:GetChildren()) do
            if ch:IsA("Model") and not BODY_PART_NAMES[ch.Name] then
                local onlyLimbs = true
                local hasLimb = false
                for _, d in ipairs(ch:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local n = d.Name
                        if r6LimbNames[n] or r15LimbNames[n] or BODY_PART_NAMES[n] then
                            hasLimb = true
                        else
                            onlyLimbs = false
                        end
                    end
                end
                if hasLimb and onlyLimbs then
                    table.insert(toDestroy, ch)
                end
            end
        end
        for _, obj in ipairs(toDestroy) do
            pcall(function() obj:Destroy() end)
        end

        -- Dedupe body parts by name: keep only the first of each canonical limb (kills double legs)
        local seenBody = {}
        local dedupeKill = {}
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and BODY_PART_NAMES[d.Name] then
                if seenBody[d.Name] then
                    table.insert(dedupeKill, d)
                else
                    seenBody[d.Name] = d
                end
            end
        end
        for _, obj in ipairs(dedupeKill) do
            pcall(function() obj:Destroy() end)
        end

        -- force canonical limb parts visible only (exact body names, not every *leg* mesh)
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and BODY_PART_NAMES[d.Name] then
                if d.Name ~= "HumanoidRootPart" then
                    d.Transparency = math.min(d.Transparency, 0)
                    d.LocalTransparencyModifier = 0
                end
                d.Anchored = false
                d.CanCollide = false
            end
        end
    end

    local function preparePreviewModel(src, keepGear)
        local model = deepCloneModel(src)
        if not model then
            local lp = Players.LocalPlayer
            if lp and lp.Character and lp.Character ~= src then
                model = deepCloneModel(lp.Character)
            end
        end
        if not model then
            model = createFallbackDummy()
        end
        model.Name = "PreviewChar"

        if not keepGear then
            stripPreviewGear(model)
        else
            -- Still remove duplicate R6/R15 limbs that cause extra legs even when gear is kept
            local isR15 = model:FindFirstChild("UpperTorso") ~= nil or model:FindFirstChild("LowerTorso") ~= nil
            local kill = {}
            if isR15 then
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local n = d.Name
                        if n == "Left Leg" or n == "Right Leg" or n == "Left Arm" or n == "Right Arm" or n == "Torso" then
                            table.insert(kill, d)
                        end
                    end
                end
            end
            for _, obj in ipairs(kill) do
                pcall(function() obj:Destroy() end)
            end
        end

        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.CanCollide = false
                d.CastShadow = false
                d.Anchored = false
                d.Massless = true
                d.LocalTransparencyModifier = 0
                if d.Name ~= "HumanoidRootPart" and d.Transparency >= 1 then
                    -- keep intentionally invisible parts (some rigs hide HRP only)
                elseif d.Name ~= "HumanoidRootPart" then
                    -- ensure limbs are not left fully invisible by gear systems
                    if d.Transparency > 0.9 then
                        d.Transparency = 0
                    end
                end
            elseif d:IsA("Humanoid") then
                d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                d.PlatformStand = false
                d.AutoRotate = false
                d.WalkSpeed = 0
                d.JumpPower = 0
                pcall(function() d.JumpHeight = 0 end)
                pcall(function() d:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)
                pcall(function() d:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
                pcall(function() d:SetStateEnabled(Enum.HumanoidStateType.Freefall, false) end)
            end
        end

        local hrp = model:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then
            hrp.Transparency = 1
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum then
            hum = Instance.new("Humanoid")
            hum.Name = "Humanoid"
            hum.Parent = model
        end
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.PlatformStand = false
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        pcall(function() hum.JumpHeight = 0 end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)

        if model:FindFirstChild("UpperTorso") then
            pcall(function() hum.RigType = Enum.HumanoidRigType.R15 end)
        elseif model:FindFirstChild("Torso") then
            pcall(function() hum.RigType = Enum.HumanoidRigType.R6 end)
        end

        local root = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Torso")
            or model:FindFirstChild("UpperTorso")
            or model.PrimaryPart
        if not root then
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then root = p break end
            end
        end
        if root then
            model.PrimaryPart = root
            -- Keep Motor6D for limb anims; remove Weld/WeldConstraint so gear CFrames can be driven live
            local kill = {}
            for _, d in ipairs(model:GetDescendants()) do
                local cn = d.ClassName
                if cn == "Weld" or cn == "WeldConstraint" or cn == "ManualWeld" or cn == "ManualGlue" or cn == "Snap" then
                    table.insert(kill, d)
                end
            end
            for _, d in ipairs(kill) do
                pcall(function() d:Destroy() end)
            end
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.CanQuery = false
                    p.CanTouch = false
                    p.Massless = true
                    p.CastShadow = false
                    -- limbs stay unanchored (Motor6D); gear/accessory parts get anchored for Live CFrame
                    if p.Name == "HumanoidRootPart" then
                        p.Anchored = true
                    elseif p.Parent and (p.Parent:IsA("Accessory") or p.Parent:IsA("Tool") or p.Name == "Handle") then
                        p.Anchored = true
                    else
                        p.Anchored = false
                    end
                end
            end
            pcall(function()
                model:PivotTo(CFrame.new(0, 2, 0))
            end)
            root.Anchored = true
            root.CFrame = CFrame.new(0, 2, 0)
            local hold = Instance.new("Part")
            hold.Name = "PreviewHold"
            hold.Anchored = true
            hold.CanCollide = false
            hold.Transparency = 1
            hold.Size = Vector3.new(0.2, 0.2, 0.2)
            hold.CFrame = root.CFrame
            hold.Parent = model
        end

        for _, d in ipairs(hum:GetChildren()) do
            if d:IsA("Animator") then d:Destroy() end
        end
        local animator = Instance.new("Animator")
        animator.Parent = hum

        local ac = model:FindFirstChildOfClass("AnimationController")
        if ac then
            pcall(function() ac:Destroy() end)
        end

        -- Ensure only one preview character exists in the viewport World
        for _, ch in ipairs(World:GetChildren()) do
            if ch:IsA("Model") and ch ~= model then
                pcall(function() ch:Destroy() end)
            end
        end
        model.Parent = World
        return model, hum
    end

