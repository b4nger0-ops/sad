    updatePlayerScrollCanvas = function()
        -- Grow the list host to fit EVERY player row; scrolling is only on the groupbox/tab
        local contentH = listLayout.AbsoluteContentSize.Y
        local pad = 12
        local total = math.max(40, contentH + pad)
        scroll.Size = UDim2.new(1, -4, 0, total)
        if listHost then
            listHost.Size = UDim2.new(1, 0, 0, total + 4)
