                        Value = keyText,
                        Mode = (kbEntry and kbEntry.Mode) or (opts.Mode or "Hold"),
                        KeyName = keyText,
                        GetActive = function()
                            return kbEntry and computeActive(kbEntry) or false
                        end,
                        GetMode = function()
                            return kbEntry and kbEntry.Mode or "Hold"
                        end,
                        SetMode = function(self, m)
                            if kbEntry then
                                kbEntry.Mode = m
                            end
                            self.Mode = m
                            refreshKeybindViewer()
                        end,
                        GetKey = function()
                            return kbEntry and kbEntry.KeyCodes or {}
                        end,
                        SetKey = function(self, keyStr)
                            if type(keyStr) ~= "string" then return end
                            keyBtn.Text = keyStr
                            resizeToText(keyStr)
                            self.Value = keyStr
                            self.KeyName = keyStr
                            if kbEntry then
                                local codes = {}
                                for part in string.gmatch(keyStr, "[^%+]+") do
                                    local trimmed = part:match("^%s*(.-)%s*$")
                                    local ok, kc = pcall(function() return Enum.KeyCode[trimmed] end)
                                    if ok and kc then table.insert(codes, kc) end
                                end
                                kbEntry.KeyCodes = codes
                                kbEntry.KeyName = formatKeyName(codes)
                                if kbEntry.KeyName == "" then kbEntry.KeyName = "None" end
                                self.Value = kbEntry.KeyName
                                self.KeyName = kbEntry.KeyName
                                keyBtn.Text = kbEntry.KeyName
                                resizeToText(kbEntry.KeyName)
                                refreshKeybindViewer()
                            end
                        end,
                        SetValue = function(self, keyStr) self:SetKey(keyStr) end,
                        
                        AddColorPicker = function(_, o) return attachSide(parentRow, "Color", o) end,
                        AddKeyPicker = function(_, o) return attachSide(parentRow, "Key", o) end,
                    }
                    
                    local oldFinishHook = opts.Callback
                    
                    
                    if kbEntry then
                        keyObj.Value = kbEntry.KeyName
                        keyObj.KeyName = kbEntry.KeyName
                        keyObj.Mode = kbEntry.Mode
                    end
                    keyObjRef = keyObj
                    local flag = opts.Flag or opts.Name
                    if flag then
                        Library.Options[flag] = keyObj
                    end
                    return keyObj
                end
            end

