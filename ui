    function SaveManager:Save(name)
        if not name or name == "" or name == "--" then
            return false, "no config file is selected"
        end
        local fullPath = self.Folder .. "/settings/" .. name .. ".json"
        local data = { objects = {} }

        for idx, toggle in next, Library.Toggles do
            if not self.Ignore[idx] and toggle and toggle.Type == "Toggle" then
                local entry = self.Parser.Toggle.Save(idx, toggle)
                if entry then table.insert(data.objects, entry) end
            end
        end
        for idx, option in next, Library.Options do
            if self.Ignore[idx] or not option then continue end
            local parser = self.Parser[option.Type]
            if parser then
                local entry = parser.Save(idx, option)
                if entry then table.insert(data.objects, entry) end
            end
        end

        local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
        if not success then return false, "failed to encode data" end
        local ok, err = safeWrite(fullPath, encoded)
        if not ok then return false, err end
        return true
    end

    function SaveManager:Load(name)
        if not name or name == "" or name == "--" then
            return false, "no config file is selected"
        end
        local file = self.Folder .. "/settings/" .. name .. ".json"
        if not safeIsFile(file) then return false, "invalid file" end
        local okRead, raw = safeRead(file)
        if not okRead then return false, raw end
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if not success or type(decoded) ~= "table" or type(decoded.objects) ~= "table" then
            return false, "decode error"
        end
        for _, option in next, decoded.objects do
            local parser = self.Parser[option.type]
            if parser then
                task.spawn(function()
                    pcall(function()
                        parser.Load(option.idx, option)
                    end)
                end)
            end
        end
        return true
    end

