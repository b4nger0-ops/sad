            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not resizing or not resizeMode or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if PreviewLocked then return end
            local d = inputXY(i) - resizeStart
            local m = resizeMode
            local left, top = posStart.X, posStart.Y
            local w, h = sizeStart.X, sizeStart.Y

            -- only touch the axes that the grip controls (prevents jump/creep)
            if m == "L" or m == "TL" or m == "BL" then
                left = posStart.X + d.X
                w = sizeStart.X - d.X
            elseif m == "R" or m == "TR" or m == "BR" then
                w = sizeStart.X + d.X
            end
            if m == "T" or m == "TL" or m == "TR" then
                top = posStart.Y + d.Y
                h = sizeStart.Y - d.Y
            elseif m == "B" or m == "BL" or m == "BR" then
                h = sizeStart.Y + d.Y
            end

            local MAX_W, MAX_H = maxPreviewSize()
            if w < MIN_W then
                if m == "L" or m == "TL" or m == "BL" then
                    left = left - (MIN_W - w)
                end
                w = MIN_W
            elseif w > MAX_W then
                if m == "L" or m == "TL" or m == "BL" then
                    left = left + (w - MAX_W)
                end
                w = MAX_W
            end
            if h < MIN_H then
                if m == "T" or m == "TL" or m == "TR" then
                    top = top - (MIN_H - h)
                end
                h = MIN_H
            elseif h > MAX_H then
                if m == "T" or m == "TL" or m == "TR" then
                    top = top + (h - MAX_H)
                end
                h = MAX_H
            end

            ESPFrame.AnchorPoint = Vector2.new(0, 0)
            ESPFrame.Position = UDim2.fromOffset(left, top)
            ESPFrame.Size = UDim2.fromOffset(w, h)
            pcall(frameCamera)
        end)
    end

