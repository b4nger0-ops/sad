local AUTH_XOR_KEY = "SecretServices_Key_7f3a"

local function xorCryptStr(str, key)
    key = key or AUTH_XOR_KEY
    local out = table.create(#str)
    for i = 1, #str do
        local a = string.byte(str, i)
        local b = string.byte(key, ((i - 1) % #key) + 1)
        out[i] = string.char(bit32.bxor(a, b))
    end
    return table.concat(out)
end

local function b64encode(data)
    if crypt and crypt.base64encode then
        local ok, r = pcall(crypt.base64encode, data)
        if ok and r then return r end
    end
    if syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.encode then
        local ok, r = pcall(syn.crypt.base64.encode, data)
        if ok and r then return r end
    end
    if base64_encode then
        local ok, r = pcall(base64_encode, data)
        if ok and r then return r end
    end
    -- pure Lua fallback
    local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    return ((data:gsub(".", function(x)
        local r, bv = "", x:byte()
        for i = 8, 1, -1 do
            r = r .. (bv % 2 ^ i - bv % 2 ^ (i - 1) > 0 and "1" or "0")
        end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
        if #x < 6 then return "" end
        local c = 0
        for i = 1, 6 do
            c = c + (x:sub(i, i) == "1" and 2 ^ (6 - i) or 0)
        end
        return b:sub(c + 1, c + 1)
    end) .. ({ "", "==", "=" })[#data % 3 + 1])
end

local function encodeAuthPayload(tbl)
    local json = HttpService:JSONEncode(tbl)
    local xored = xorCryptStr(json, AUTH_XOR_KEY)
    return b64encode(xored)
end

