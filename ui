    function Window.UpdateUtilityGradient()
        local seq = decorSeq()
        
        for _, g in ipairs(Window.UtilityGradients) do
            pcall(function() g:Destroy() end)
        end
        Window.UtilityGradients = {}

        local function stripGrad(obj)
            if not obj then return end
            local existing = obj:FindFirstChildOfClass("UIGradient")
            if existing then existing:Destroy() end
        end

        local function dimSeq(s, f)
            f = f or 0.42
            local keys = {}
            for _, kp in ipairs(s.Keypoints) do
                local c = kp.Value
                table.insert(keys, ColorSequenceKeypoint.new(
                    kp.Time,
                    Color3.new(
                        math.clamp(c.R * f + 0.04, 0, 1),
                        math.clamp(c.G * f + 0.04, 0, 1),
                        math.clamp(c.B * f + 0.04, 0, 1)
                    )
                ))
            end
            return ColorSequence.new(keys)
        end
        local softSeq = dimSeq(seq, 0.40)
        local function attachBg(obj)
            if not obj or not obj.Parent then return end
            stripGrad(obj)
            obj.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            local g = Instance.new("UIGradient")
            g.Color = softSeq
            g.Parent = obj
            table.insert(Window.UtilityGradients, g)
        end

        if not UtilityGradientEnabled then
            
            for _, entry in ipairs(Window.UtilityObjects) do
                pcall(function()
                    stripGrad(entry.Object)
                    entry.Object[entry.Prop] = Theme.UtilityColor
                end)
            end
            for _, btn in ipairs(Window.ButtonObjects) do
                pcall(function()
                    stripGrad(btn)
                    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
                end)
            end
            for _, t in pairs(Window.Tabs) do
                if t.Btn then
                    pcall(function()
                        stripGrad(t.Btn)
                        if t == Window.CurrentTab then
                            t.Btn.BackgroundColor3 = darker(Theme.MainColor, 0.7)
                            t.Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        else
                            t.Btn.BackgroundColor3 = darker(Theme.MainColor, 0.9)
                            t.Btn.TextColor3 = Color3.fromRGB(160, 160, 160)
                        end
                    end)
                end
            end
            for _, entry in ipairs(Window.ToggleBoxes) do
                pcall(function()
                    stripGrad(entry.Box)
                    local on = entry.GetState and entry.GetState()
                    entry.Box.BackgroundColor3 = on and Theme.UtilityColor or Theme.ToggleOff
                end)
            end
            return
        end

        
        for _, btn in ipairs(Window.ButtonObjects) do
            attachBg(btn)
        end

        
        for _, t in pairs(Window.Tabs) do
            if t.Btn then
                attachBg(t.Btn)
            end
        end

        
        for _, entry in ipairs(Window.UtilityObjects) do
            if entry.Object and entry.Prop == "BackgroundColor3" then
                attachBg(entry.Object)
            end
        end

        
        for _, entry in ipairs(Window.ToggleBoxes) do
            pcall(function()
                stripGrad(entry.Box)
                local on = entry.GetState and entry.GetState()
                if on then
                    attachBg(entry.Box)
                else
                    entry.Box.BackgroundColor3 = Theme.ToggleOff
                end
            end)
        end
    end

    
    -- Single shared gradient driver (~30fps) — replaces per-widget RenderStepped loops
    do
        local gradConn
        local t = 0
        local acc = 0
        gradConn = RunService.Heartbeat:Connect(function(dt)
            if not ScreenGui or not ScreenGui.Parent then
                if gradConn then gradConn:Disconnect() end
                return
            end
            acc = acc + dt
            if acc < 0.033 then return end
            t = t + (GradientSpeed / 50) * acc
            acc = 0
            local off = Vector2.new(math.sin(t) * 0.7, 0)
            local dSeq = decorSeq()
            if DecorGradientsEnabled and Window.DecorGradients then
                for i = #Window.DecorGradients, 1, -1 do
                    local g = Window.DecorGradients[i]
                    if not g or not g.Parent then
                        table.remove(Window.DecorGradients, i)
                    else
                        g.Enabled = true
                        g.Offset = off
                        g.Color = dSeq
                    end
                end
            elseif Window.DecorGradients then
                for _, g in ipairs(Window.DecorGradients) do
                    if g and g.Parent then g.Enabled = false end
                end
            end
            if FontGradientEnabled and Window.FontGradients then
                local seq = fontSeq()
                for i = #Window.FontGradients, 1, -1 do
                    local g = Window.FontGradients[i]
                    if not g or not g.Parent then
                        table.remove(Window.FontGradients, i)
                    else
                        g.Offset = off
                        g.Color = seq
                    end
                end
            end
            if UtilityGradientEnabled and Window.UtilityGradients then
                for i = #Window.UtilityGradients, 1, -1 do
                    local g = Window.UtilityGradients[i]
                    if not g or not g.Parent then
                        table.remove(Window.UtilityGradients, i)
                    else
                        g.Offset = off
                        g.Color = dSeq
                    end
                end
            end
        end)
        Window._disconnectGradDriver = function()
            if gradConn then pcall(function() gradConn:Disconnect() end) gradConn = nil end
        end
    end

