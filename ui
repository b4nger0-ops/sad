                    AddKeyPicker  = function(_, o)
                        o = o or {}
                        o.Name = o.Name or text
                        o.Mode = o.Mode or "Hold"
                        if flag and not o.Flag then o.Flag = flag .. "_Key" end
                        o.DefaultToggled = state
                        o.OnToggle = function(newVal)
                            set(newVal, true)
                        end
                        local result = attachSide(row, "Key", o)
                        
                        for _, e in ipairs(KeybindRegistry) do
                            if e.Name == o.Name then
                                linkedKb = e
                                break
                            end
                        end
                        return result
                    end,
                }
            end

            function group:AddSlider(text, opts)
                opts = opts or {}
                local min = opts.Min or 0
                local max = opts.Max or 100
                local def = opts.Default or min

                
                local decimals = opts.Decimals
                if decimals == nil then
                    if opts.Increment then
                        decimals = getDecimals(opts.Increment)
                    else
                        decimals = math.max(getDecimals(min), getDecimals(max), getDecimals(def))
                    end
                end
                local step = opts.Increment or (10 ^ (-decimals))

                local row = Instance.new("Frame")
                row.BackgroundTransparency = 1
                row.Size = UDim2.new(1, 0, 0, 34)
                registerFeature(text, row)
                row.Parent = cont

                local lbl = Instance.new("TextLabel")
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1, -48, 0, 14)
                lbl.Font = Font
                lbl.Text = text
                lbl.TextColor3 = Theme.FontColor
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = row
                register(lbl, {TextColor3 = "FontColor"})

                local box = Instance.new("TextBox")
                box.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                box.BorderSizePixel = 0
                box.Position = UDim2.new(1, -44, 0, 0)
                box.Size = UDim2.fromOffset(42, 14)
                box.Font = Font
                box.TextColor3 = Theme.FontColor
                box.TextSize = 11
                box.ClearTextOnFocus = false
                box.ClipsDescendants = true
                box.TextXAlignment = Enum.TextXAlignment.Center
                box.TextYAlignment = Enum.TextYAlignment.Center
                box.Parent = row
                Instance.new("UIStroke", box).Color = Theme.OutlineColor
                local sliderPad = Instance.new("UIPadding")
                sliderPad.PaddingLeft = UDim.new(0, 3)
                sliderPad.PaddingRight = UDim.new(0, 3)
                sliderPad.Parent = box

                local track = Instance.new("Frame")
                track.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                track.BorderSizePixel = 0
                track.Position = UDim2.new(0, 0, 0, 18)
                track.Size = UDim2.new(1, 0, 0, 10)
                track.Parent = row

                local fill = Instance.new("Frame")
                fill.BackgroundColor3 = Theme.UtilityColor
                fill.BorderSizePixel = 0
                fill.Parent = track
                registerUtility(fill, "BackgroundColor3")

                if opts.Tooltip then Tooltip:Attach(row, opts.Tooltip) end

                local val = def
                local sliderObj = {
                    Type = "Slider",
                    Value = val,
                    SetValue = nil,
                    GetValue = function() return val end,
                }

                local function formatVal(v)
                    if decimals <= 0 then
                        return tostring(math.floor(v + 0.5))
                    end
                    return string.format("%." .. decimals .. "f", v)
                end

                local function set(v, instant)
                    v = math.clamp(v, min, max)
                    
                    if step > 0 then
                        v = math.floor((v - min) / step + 0.5) * step + min
                        v = roundTo(v, decimals)
                    end
                    v = math.clamp(v, min, max)
                    val = v
                    sliderObj.Value = val

                    local pct = (max > min) and ((val - min) / (max - min)) or 0
                    if val > min and pct < 0.02 then pct = 0.02 end

                    if instant then
                        fill.Size = UDim2.new(pct, 0, 1, 0)
                    else
                        TweenService:Create(fill, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(pct, 0, 1, 0)
                        }):Play()
                    end
                    box.Text = formatVal(val)
                    if opts.Callback then opts.Callback(val) end
                end
                set(def, true)

                local drag = false
                track.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        drag = true
                        local raw = min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        set(raw, true)
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                        local raw = min + (max - min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        set(raw, true)
                    end
                end)
                box.FocusLost:Connect(function()
                    local n = tonumber(box.Text)
                    if n then set(n, false) else box.Text = formatVal(val) end
                end)

                sliderObj.SetValue = function(_, v) set(v, false) end
                if opts.Flag then
                    Library.Options[opts.Flag] = sliderObj
                end
                return {
                    Type = "Slider",
                    Value = val,
                    SetValue = function(_, v) set(v, false) end,
                    GetValue = function() return val end,
                    AddColorPicker = function(_, o) return attachSide(row, "Color", o) end,
                    AddKeyPicker  = function(_, o) return attachSide(row, "Key", o) end,
                }
            end

