    local dragging, dragStart, startPos
    local function beginMainDrag(i)
        if not IsClickInput(i) then return end
        local mouse = inputXY(i)
        local rel = mouse - MainWindow.AbsolutePosition
        local sz = MainWindow.AbsoluteSize
        local edge = IsMobile and 12 or 10
        -- leave outer edges free for resize grips
        if rel.X <= edge or rel.X >= sz.X - edge or rel.Y <= edge or rel.Y >= sz.Y - edge then
            return
        end
        dragging = true
        dragStart = mouse
        startPos = MainWindow.Position
    end
    -- Drag from title bar (and search bar on desktop). On mobile only title bar so taps work.
    TitleBar.InputBegan:Connect(beginMainDrag)
    TitleBar.Active = true
    if not IsMobile then
        for _, childName in ipairs({ "TabBar", "Header", "Footer", "FeatureSearchBar" }) do
            local ch = MainWindow:FindFirstChild(childName)
            if ch then
                ch.InputBegan:Connect(beginMainDrag)
                if ch:IsA("GuiObject") then
                    ch.Active = true
                end
            end
        end
        local footerBar = MainWindow:FindFirstChild("Footer") or MainWindow:FindFirstChild("FooterBar")
        if footerBar then
            footerBar.InputBegan:Connect(beginMainDrag)
            footerBar.Active = true
        end
    end
    local function endMainDrag(i)
        if IsClickInput(i) then dragging = false end
    end
    TitleBar.InputEnded:Connect(endMainDrag)
    UserInputService.InputEnded:Connect(endMainDrag)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and IsHoverInput(i) then
            local d = inputXY(i) - dragStart
            MainWindow.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    -- Outline resize grips for main GUI
    do
        local EDGE = 6
        local MIN_W, MIN_H = 560, 480
        local MAX_W, MAX_H = 1400, 1000
        if IsMobile then
            MIN_W, MIN_H = 280, 300
            MAX_W, MAX_H = 620, 700
        end
        local resizing, resizeMode, resizeStart, sizeStart, posStart

        local gripFolder = Instance.new("Folder")
        gripFolder.Name = "ResizeGrips"
        gripFolder.Parent = MainWindow
        local function makeGrip(name, props)
            local g = Instance.new("Frame")
            g.Name = name
            g.BackgroundColor3 = Theme.AccentColor
            g.BackgroundTransparency = 1 -- invisible grab outline
            g.BorderSizePixel = 0
            g.ZIndex = 120
            for k, v in pairs(props) do g[k] = v end
            g.Parent = gripFolder
            return g
        end
        makeGrip("Top", { Size = UDim2.new(1, 0, 0, EDGE), Position = UDim2.fromOffset(0, 0) })
        makeGrip("Bottom", { Size = UDim2.new(1, 0, 0, EDGE), Position = UDim2.new(0, 0, 1, -EDGE) })
        makeGrip("Left", { Size = UDim2.new(0, EDGE, 1, 0), Position = UDim2.fromOffset(0, 0) })
        makeGrip("Right", { Size = UDim2.new(0, EDGE, 1, 0), Position = UDim2.new(1, -EDGE, 0, 0) })

        local function hitEdge(rel, sz)
            local onL = rel.X <= EDGE + 2
            local onR = rel.X >= sz.X - EDGE - 2
            local onT = rel.Y <= EDGE + 2
            local onB = rel.Y >= sz.Y - EDGE - 2
            if onT and onL then return "TL" end
            if onT and onR then return "TR" end
            if onB and onL then return "BL" end
            if onB and onR then return "BR" end
            if onT then return "T" end
            if onB then return "B" end
            if onL then return "L" end
            if onR then return "R" end
            return nil
        end

        local function updateHover()
            if resizing then return end
            if not MainWindow.Parent or not MainWindow.Visible or (Window and Window.Closed) then
                -- don't hide if ESP is showing cursor
                return
            end
            local m = UserInputService:GetMouseLocation()
            local a, s = MainWindow.AbsolutePosition, MainWindow.AbsoluteSize
            local rel = Vector2.new(m.X - a.X, m.Y - a.Y)
            if rel.X < -4 or rel.Y < -4 or rel.X > s.X + 4 or rel.Y > s.Y + 4 then
                return
            end
            local mode = hitEdge(rel, s)
            if mode then
                showResizeCursor(true)
            end
        end
        RunService.RenderStepped:Connect(updateHover)

        UserInputService.InputBegan:Connect(function(i, gp)
            if gp then return end
            if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if not MainWindow.Parent or not MainWindow.Visible then return end
            if Window and Window.Closed then return end
            local mouse = inputXY(i)
            local absPos = MainWindow.AbsolutePosition
            local sz = MainWindow.AbsoluteSize
            local rel = mouse - absPos
            if rel.X < -2 or rel.Y < -2 or rel.X > sz.X + 2 or rel.Y > sz.Y + 2 then return end
            local mode = hitEdge(rel, sz)
            if not mode then return end
            resizing = true
            resizeMode = mode
            resizeStart = mouse
            sizeStart = sz
            posStart = absPos
            dragging = false
            MainWindow.AnchorPoint = Vector2.new(0, 0)
            MainWindow.Position = UDim2.fromOffset(posStart.X, posStart.Y)
            MainWindow.Size = UDim2.fromOffset(sizeStart.X, sizeStart.Y)
            showResizeCursor(true)
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                resizing = false
                resizeMode = nil
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not resizing or not resizeMode or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            local d = inputXY(i) - resizeStart
            local m = resizeMode
            local left, top = posStart.X, posStart.Y
            local w, h = sizeStart.X, sizeStart.Y

            if m == "L" or m == "TL" or m == "BL" then
                left = posStart.X + d.X
                w = sizeStart.X - d.X
            elseif m == "R" or m == "TR" or m == "BR" then
                w = sizeStart.X + d.X
            end
            if m == "T" or m == "TL" or m == "TR" then
                top = posStart.Y + d.Y
                h = sizeStart.Y - d.Y
            elseif m == "B" or m == "BL" or m == "BR" then
                h = sizeStart.Y + d.Y
            end

            if w < MIN_W then
                if m == "L" or m == "TL" or m == "BL" then left = left - (MIN_W - w) end
                w = MIN_W
            elseif w > MAX_W then
                if m == "L" or m == "TL" or m == "BL" then left = left + (w - MAX_W) end
                w = MAX_W
            end
            if h < MIN_H then
                if m == "T" or m == "TL" or m == "TR" then top = top - (MIN_H - h) end
                h = MIN_H
            elseif h > MAX_H then
                if m == "T" or m == "TL" or m == "TR" then top = top + (h - MAX_H) end
                h = MAX_H
            end

            MainWindow.AnchorPoint = Vector2.new(0, 0)
            MainWindow.Position = UDim2.fromOffset(left, top)
            MainWindow.Size = UDim2.fromOffset(w, h)
            if Window.RelayoutTabs then
                pcall(function() Window:RelayoutTabs() end)
            end
        end)
    end

    local function fadeAll(targetTrans, onComplete)
        local info = uiAnimInfo(Window.FadeTime or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tweens = {}
        table.insert(tweens, TweenService:Create(MainWindow, info, {BackgroundTransparency = targetTrans}))
        table.insert(tweens, TweenService:Create(WindowStroke, info, {Transparency = targetTrans}))
        local mwb = ScreenGui:FindFirstChild("MainWindowBorder")
        if mwb then
            table.insert(tweens, TweenService:Create(mwb, info, {BackgroundTransparency = targetTrans}))
        end
        for _, v in ipairs(MainWindow:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                table.insert(tweens, TweenService:Create(v, info, {TextTransparency = targetTrans}))
            end
            if v:IsA("ImageLabel") or v:IsA("ImageButton") then
                table.insert(tweens, TweenService:Create(v, info, {ImageTransparency = targetTrans}))
            end
            if v:IsA("UIStroke") then
                table.insert(tweens, TweenService:Create(v, info, {Transparency = targetTrans}))
            end
            if v:IsA("Frame") and (v == TitleBar or v == TabBar or v == Header or v == ContentContainer) then
                table.insert(tweens, TweenService:Create(v, info, {BackgroundTransparency = targetTrans}))
            end
        end
        for _, tw in ipairs(tweens) do tw:Play() end
        if onComplete then task.delay(Window.FadeTime + 0.03, onComplete) end
    end

