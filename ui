    local function findGameCharacterModel()
        local lp = Players.LocalPlayer
        -- Prefer LocalPlayer.Character first (works in all games, not just specific ones)
        if lp and lp.Character then
            local char = lp.Character
            local hasRoot = char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
                or char.PrimaryPart
            local hasHead = char:FindFirstChild("Head")
            if hasRoot and hasHead then
                return char, "LocalPlayer.Character"
            end
        end
        -- workspace.LocalPlayerName fallback
        if lp then
            local direct = workspace:FindFirstChild(lp.Name)
            if direct and direct:IsA("Model") then
                local hasRoot = direct:FindFirstChild("HumanoidRootPart")
                    or direct:FindFirstChild("UpperTorso")
                    or direct:FindFirstChild("Torso")
                local hasHead = direct:FindFirstChild("Head")
                if hasRoot and hasHead then
                    return direct, "workspace." .. lp.Name
                end
            end
        end
        -- Any valid character model in the game
        local list = findAllCharacterModels()
        if #list > 0 then
            return list[1].model, list[1].label
        end
        return nil, nil
    end

