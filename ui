    local function normalizeAnimId(id)
        if type(id) ~= "string" or id == "" then return nil end
        if id:find("rbxassetid://") or id:find("rbxasset://") then return id end
        local num = id:match("id=(%d+)") or id:match("^(%d+)$")
        if num then return "rbxassetid://" .. num end
        return id
    end

    local function collectIdsFromAnimateNode(node)
        local ids = {}
        if not node then return ids end
        local function consider(val)
            local nid = normalizeAnimId(val)
            if nid then table.insert(ids, nid) end
        end
        if node:IsA("Animation") then
            consider(node.AnimationId)
        elseif node:IsA("StringValue") then
            consider(node.Value)
        end
        for _, ch in ipairs(node:GetDescendants()) do
            if ch:IsA("Animation") then
                consider(ch.AnimationId)
            elseif ch:IsA("StringValue") then
                consider(ch.Value)
            end
        end
        return ids
    end

