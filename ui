                    local function resizeToText(txt)
                        local w = math.clamp(getTextWidth(txt, 11) + 12, 28, 130)
                        keyBtn.Size = UDim2.fromOffset(w, 16)
                        layoutSides(parentRow)
                    end

                    local kbEntry = nil
                    if opts.Name then
                        kbEntry = registerKeybind(opts.Name, keyText, {
                            Mode = opts.Mode or "Hold",
                            DefaultToggled = opts.DefaultToggled or false,
                            OnToggle = opts.OnToggle,
                            OnState = opts.OnState,
                        })
                    end

                    local keyObjRef = nil 

                    local listening = false
                    keyBtn.MouseButton1Click:Connect(function()
                        if listening then return end
                        listening = true
                        keyBtn.Text = "..."
                        resizeToText("...")

                        local captured = {} 
                        local capturedSet = {}
                        local beganConn, endedConn

                        local function finish()
                            if not listening then return end
                            listening = false
                            if beganConn then beganConn:Disconnect() end
                            if endedConn then endedConn:Disconnect() end

                            if #captured == 0 then
                                keyBtn.Text = kbEntry and kbEntry.KeyName or keyText
                                resizeToText(keyBtn.Text)
                                return
                            end

                            local name = formatKeyName(captured)
                            keyBtn.Text = name
                            resizeToText(name)

                            if kbEntry then
                                kbEntry.KeyCodes = captured
                                kbEntry.KeyName = name
                            end
                            
                            if keyObjRef then
                                keyObjRef.Value = name
                                keyObjRef.KeyName = name
                                if kbEntry then keyObjRef.Mode = kbEntry.Mode end
                            end
                            if opts.Callback then
                                opts.Callback(#captured == 1 and captured[1] or captured)
                            end
                        end

                        beganConn = UserInputService.InputBegan:Connect(function(inp)
                            if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
                            if not capturedSet[inp.KeyCode] then
                                capturedSet[inp.KeyCode] = true
                                table.insert(captured, inp.KeyCode)
                                local preview = formatKeyName(captured)
                                keyBtn.Text = preview
                                resizeToText(preview)
                            end
                        end)

                        endedConn = UserInputService.InputEnded:Connect(function(inp)
                            if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
                            
                            if #captured == 0 then return end
                            local anyStillDown = false
                            for _, kc in ipairs(captured) do
                                if UserInputService:IsKeyDown(kc) then
                                    anyStillDown = true
                                    break
                                end
                            end
                            if not anyStillDown then
                                finish()
                            end
                        end)
                    end)

                    
